{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/vlm_rationale.schema.json",
  "title": "I5 vlm_rationale 입력·결과",
  "description": "I5 job_type vlm_rationale 의 입력(job_request.payload.input)과 결과(job_callback.payload.result) (명세 12.5, 5.4 빠른 경로, 11.3 vlm_assessment). VLM 은 설명과 상향 의견만 낸다. 경보를 낮추거나 끄거나 해소하지 못한다 (원칙 6, AGENTS.md 규칙 4). 결과에는 하향·해소를 표현할 필드가 없고, proposed_severity 는 입력 severity 보다 높은 등급이거나 null 이다. 이 파일은 정의만 담고 메시지는 job_request·job_callback 이다.",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "event_id", "event_sequence", "rule_id", "rule_version", "severity", "confidence",
        "needs_check", "world_ids", "zone_id", "metrics", "observation_time", "frames", "structured_state"
      ],
      "properties": {
        "event_id": { "$ref": "../common/defs.schema.json#/$defs/uuid_v7" },
        "event_sequence": { "type": "integer", "minimum": 1, "description": "근거를 붙일 이벤트 상태" },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "integer", "minimum": 1 },
        "severity": { "$ref": "../common/defs.schema.json#/$defs/severity", "description": "규칙 결과 등급. 결과의 severity 로 그대로 되돌린다" },
        "confidence": { "$ref": "../common/defs.schema.json#/$defs/risk_confidence" },
        "needs_check": { "type": "boolean" },
        "world_ids": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/world_id" },
          "uniqueItems": true
        },
        "zone_id": { "type": ["string", "null"], "minLength": 1 },
        "metrics": { "$ref": "../common/defs.schema.json#/$defs/rule_metrics" },
        "observation_time": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "description": "이벤트 시점 프레임과 직전 3~5초 프레임 (event_frame_ready 의 주소)",
          "items": {
            "type": "object",
            "description": "촬영 시각 세 값은 event_frame_ready 의 값을 그대로 쓴다 (3.9)",
            "allOf": [{ "$ref": "../common/defs.schema.json#/$defs/capture_time" }],
            "required": ["camera_id", "frame_uri", "face_policy"],
            "properties": {
              "camera_id": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
              "frame_uri": { "$ref": "../common/defs.schema.json#/$defs/object_uri" },
              "estimated_capture_time_ms": true,
              "timestamp_source": true,
              "timestamp_uncertainty_ms": true,
              "local_copy": { "$ref": "../common/defs.schema.json#/$defs/pod_local_frame", "description": "event_frame_ready 의 같은 Pod 로컬 사본(1.1.0, S15P31A101-408). 워커는 상태 폴더 안·크기·sha256 이 맞을 때만 읽고, 아니면 frame_uri 를 쓴다" },
              "face_policy": {
                "enum": ["BLURRED", "EXCLUDED"],
                "description": "VLM 입력 프레임은 얼굴 영역을 흐림 처리한 뒤 넣는다 (5.4). 안전모가 보이도록 머리 윗부분은 남긴다. 처리는 분석 워커가 VLM 호출 직전에 이 값대로 한다(올라온 프레임은 흐리지 않은 원본일 수 있다, S15P31A101-206)"
              }
            },
            "additionalProperties": false
          }
        },
        "structured_state": {
          "type": "object",
          "description": "이벤트 시점 구조화 상태(관련 World Track·구역 요약). 위치의 정본은 Tier 0 값이며 VLM 은 이를 고치지 않는다"
        },
        "world_state_ref": { "$ref": "../common/defs.schema.json#/$defs/uuid", "description": "근거가 된 world_state msg_id" }
      }
    },

    "result": {
      "type": "object",
      "required": ["event_id", "event_sequence", "severity", "rationale", "proposed_severity", "model_version"],
      "properties": {
        "event_id": { "$ref": "../common/defs.schema.json#/$defs/uuid_v7" },
        "event_sequence": { "type": "integer", "minimum": 1, "description": "입력의 event_sequence 를 그대로" },
        "severity": {
          "$ref": "../common/defs.schema.json#/$defs/severity",
          "description": "입력의 규칙 등급을 그대로 되돌린다. 상향 의견 비교 기준이며 VLM 이 바꾸는 값이 아니다"
        },
        "rationale": { "type": "string", "minLength": 1, "description": "근거 문장 (한국어)" },
        "proposed_severity": {
          "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/severity" }, { "type": "null" }],
          "description": "상향 의견. severity 보다 높은 등급만. 의견이 없거나 같거나 낮다고 보면 null (하향 불가)"
        },
        "clause_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "RAG 로 검색된 조항 ID 만 (5.4, 자동 검사)"
        },
        "model_version": { "type": "string", "minLength": 1 },
        "latency_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "../common/defs.schema.json#/$defs/severity_upward_only" }]
    }
  }
}
