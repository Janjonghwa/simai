{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/watch_escalation.schema.json",
  "title": "I2 watch_escalation",
  "description": "EC2 → 관제 화면, STOMP /topic/watch (확장 부록 C.6, FR-46, 12.4). EC2 가 BOUND 워치에 보낸 watch_alert 에 VIBRATED watch_ack 가 ack_within_ms 안에 오지 않았거나(NO_ACK) 보내지 못했을 때(SEND_FAILED) 관리자에게 알리는 격상이다. 한 알림에 한 번만 보낸다. 워치 ACK·격상은 운영자 확인(3.2)이 아니며 이벤트 상태를 바꾸지 않는다. CRITICAL·HIGH 이벤트의 현장 경보는 Tier 0·노트북이 이미 울리고, EC2 가 CAUTION 을 현장 경보로 올리는 경로는 없다(S15P31A101-338 설계 server-watch-alert.md 남은 일). 사람 이름을 싣지 않는다(익명 World ID·기기 ID, 11.4-5). 1.0.0 신설(S15P31A101-338).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "msg_type": {
      "const": "watch_escalation"
    },
    "payload": {
      "type": "object",
      "required": [
        "event_id",
        "event_sequence",
        "alert_msg_id",
        "device_id",
        "world_id",
        "severity",
        "reason",
        "sent_at",
        "escalated_at"
      ],
      "properties": {
        "event_id": {
          "$ref": "../common/defs.schema.json#/$defs/uuid_v7"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "워치에 알린 이벤트 상태"
        },
        "alert_msg_id": {
          "$ref": "../common/defs.schema.json#/$defs/uuid",
          "description": "격상한 watch_alert 의 봉투 msg_id"
        },
        "device_id": {
          "$ref": "../common/defs.schema.json#/$defs/instance_id",
          "description": "워치 기기 ID"
        },
        "world_id": {
          "type": "string",
          "minLength": 1,
          "description": "그 워치에 배정된 익명 World ID"
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "CAUTION"
          ]
        },
        "reason": {
          "enum": [
            "NO_ACK",
            "SEND_FAILED"
          ],
          "description": "NO_ACK: 기한(ack_within_ms) 안에 VIBRATED ACK 가 EC2 에 닿지 않음. SEND_FAILED: 워치로 보내지 못함(연결이 그 사이 끊김 등)"
        },
        "sent_at": {
          "$ref": "../common/defs.schema.json#/$defs/timestamp_ms",
          "description": "EC2 가 watch_alert 를 보낸(보내려 한) 시각"
        },
        "escalated_at": {
          "$ref": "../common/defs.schema.json#/$defs/timestamp_ms",
          "description": "EC2 가 격상한 시각"
        }
      }
    }
  }
}
