{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/coverage_guide.schema.json",
  "title": "세팅 1단계 카메라 각도 헬퍼 결과 (coverage_guide)",
  "description": "현장 게이트웨이(노트북) 별도 CPU 프로세스 → EC2(`POST /api/devices/coverage-guides`, 기기 토큰) 및 EC2 → 관제 앱(`GET /api/cameras/coverage-guides` 응답의 `latest`) 세팅 1단계 카메라 각도 헬퍼 결과 메시지(명세 3.3, 4.3, 4.5, 12.2, 13.4, 18.1, 설계 docs/design/site-setup-pipeline.md). 게이트웨이 영상 중계(`gateway/relay`)의 로컬 미리보기 WebSocket(`127.0.0.1`, `simai-cctv-preview/1`) 키프레임을 받아 추가 RTSP 세션 없이 지금 화면만으로 4대 카메라가 하나의 연결 성분을 이루는지(`CONNECTED` / `DISCONNECTED` / `UNKNOWN`)와 회전 방향 안내(`guides`)를 계산한다. 세팅 1단계 화면이 열려 있는 동안에만 계산·전송하며, 세팅 진행을 막지 않고('그대로 진행' 가능), 헬퍼의 `CONNECTED` 는 보정 성공(`CALIBRATED`)이 아니다. 영상·특징점 배열·사람 정보를 싣지 못하도록 모든 객체를 닫은(`additionalProperties: false`) 값 객체이며 공통 봉투를 쓰지 않는다. 1.0.0 신설(S15P31A101-443).",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "computed_at_ms",
    "valid_until_ms",
    "capture_skew_ms",
    "params",
    "cameras",
    "pairs",
    "connectivity",
    "components",
    "guides"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "계약 스키마 버전 (1.0.0)"
    },
    "source_id": {
      "$ref": "../common/defs.schema.json#/$defs/instance_id",
      "description": "송신 게이트웨이 식별자 (예: gw-lobby, laptop-01)"
    },
    "computed_at_ms": {
      "$ref": "../common/defs.schema.json#/$defs/timestamp_ms",
      "description": "헬퍼가 매칭·연결성을 계산한 시각 (UTC epoch ms)"
    },
    "valid_until_ms": {
      "$ref": "../common/defs.schema.json#/$defs/timestamp_ms",
      "description": "이 결과가 유효한 시각 상한 (UTC epoch ms, 기본 computed_at_ms + 10000)"
    },
    "capture_skew_ms": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ],
      "description": "OK 상태 카메라 프레임 시각(frame_ts_ms)의 최대−최소 차이(ms). OK 카메라가 2대 미만이면 null"
    },
    "params": {
      "$ref": "#/$defs/coverage_params"
    },
    "cameras": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/camera_status_item"
      },
      "description": "현장 카메라 4대의 영상 키프레임 수신 상태"
    },
    "pairs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/pair_match_item"
      },
      "description": "4대 카메라 전체 6쌍(4C2)의 배경 특징점 매칭 결과"
    },
    "connectivity": {
      "enum": ["CONNECTED", "DISCONNECTED", "UNKNOWN"],
      "description": "ENOUGH·WEAK 쌍을 간선으로 union-find 한 4대 연결 상태. 성분 1개면 CONNECTED, 카메라 중 하나라도 UNKNOWN(NO_VIDEO·STALE)이고 나머지로 판정 못 하면 UNKNOWN, 그 밖 DISCONNECTED. 헬퍼의 CONNECTED 는 보정 성공(CALIBRATED)이 아니다"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {
          "$ref": "../common/defs.schema.json#/$defs/camera_id"
        }
      },
      "description": "ENOUGH·WEAK 간선으로 묶인 연결 성분(카메라 ID 배열) 목록"
    },
    "guides": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/camera_guide_item"
      },
      "description": "카메라별 회전 방향·크기 안내 목록 (안내할 항목이 없으면 빈 배열)"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "normalized_point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "정규화 이미지 좌표 [x, y] (0.0~1.0)"
    },
    "coverage_params": {
      "type": "object",
      "description": "각도 헬퍼 판정에 사용한 파라미터와 렌즈 내부값 출처",
      "required": [
        "image_width_px",
        "max_keypoints",
        "ransac_threshold_px",
        "enough_min_inliers",
        "weak_min_inliers",
        "min_inlier_ratio",
        "intrinsics_source"
      ],
      "properties": {
        "image_width_px": {
          "type": "integer",
          "minimum": 160,
          "maximum": 4096,
          "description": "특징점 추출용 리사이즈 가로 픽셀 (기본 1024)"
        },
        "max_keypoints": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192,
          "description": "카메라당 ALIKED 최대 특징점 수 (기본 1024)"
        },
        "ransac_threshold_px": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50,
          "description": "Essential RANSAC 문턱값(px, 기본 STORED 2.0 / DEFAULT 완화)"
        },
        "enough_min_inliers": {
          "type": "integer",
          "minimum": 1,
          "description": "ENOUGH 등급 최소 인라이어 수 (기본 30)"
        },
        "weak_min_inliers": {
          "type": "integer",
          "minimum": 1,
          "description": "WEAK 등급 최소 인라이어 수 (기본 15)"
        },
        "min_inlier_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "ENOUGH·WEAK 등급 최소 인라이어 비율 inliers/raw_matches (기본 0.10)"
        },
        "intrinsics_source": {
          "enum": ["STORED", "DEFAULT"],
          "description": "STORED: 카메라별 저장된 렌즈 고유 내부값(이전 세팅 외부 자세가 아님), DEFAULT: 없을 때 화각 기본값"
        }
      },
      "additionalProperties": false
    },
    "camera_status_item": {
      "type": "object",
      "description": "카메라 1대의 로컬 미리보기 키프레임 수신 상태",
      "required": ["camera_id", "status", "frame_ts_ms"],
      "properties": {
        "camera_id": {
          "$ref": "../common/defs.schema.json#/$defs/camera_id"
        },
        "status": {
          "enum": ["OK", "NO_VIDEO", "STALE"],
          "description": "OK: 정상, NO_VIDEO: 영상 미수신, STALE: computed_at_ms 기준 프레임 나이가 헬퍼의 신선도 설정(SIMAI_CAMERA_HELPER_STALE_MS, 기본 5000 ms)을 초과함"
        },
        "frame_ts_ms": {
          "oneOf": [
            { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
            { "type": "null" }
          ],
          "description": "판정에 쓴 키프레임 시각(UTC epoch ms). NO_VIDEO 면 null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "OK" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "frame_ts_ms": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "NO_VIDEO" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "frame_ts_ms": { "type": "null" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "pair_match_item": {
      "type": "object",
      "description": "카메라 쌍 하나의 LightGlue + Essential RANSAC + recoverPose 양의 깊이 인라이어 판정",
      "required": [
        "a",
        "b",
        "raw_matches",
        "inliers",
        "inlier_ratio",
        "grade",
        "centroid_a",
        "centroid_b"
      ],
      "properties": {
        "a": {
          "$ref": "../common/defs.schema.json#/$defs/camera_id"
        },
        "b": {
          "$ref": "../common/defs.schema.json#/$defs/camera_id"
        },
        "raw_matches": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ],
          "description": "LightGlue 대응점 수. UNKNOWN 쌍은 null"
        },
        "inliers": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ],
          "description": "Essential RANSAC + recoverPose 양의 깊이를 통과한 인라이어 수. UNKNOWN 쌍은 null"
        },
        "inlier_ratio": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ],
          "description": "inliers / raw_matches 비율. UNKNOWN 쌍은 null"
        },
        "grade": {
          "enum": ["ENOUGH", "WEAK", "LACK", "UNKNOWN"],
          "description": "ENOUGH(inliers>=30 & ratio>=0.10) | WEAK(15<=inliers<30 & ratio>=0.10) | LACK(그 밖) | UNKNOWN(NO_VIDEO·STALE 카메라 포함 쌍)"
        },
        "centroid_a": {
          "oneOf": [
            { "$ref": "#/$defs/normalized_point" },
            { "type": "null" }
          ],
          "description": "카메라 a 인라이어 점들의 정규화 [0,1] 무게중심. inliers < 5 또는 UNKNOWN 이면 null"
        },
        "centroid_b": {
          "oneOf": [
            { "$ref": "#/$defs/normalized_point" },
            { "type": "null" }
          ],
          "description": "카메라 b 인라이어 점들의 정규화 [0,1] 무게중심. inliers < 5 또는 UNKNOWN 이면 null"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "grade": { "const": "UNKNOWN" } },
            "required": ["grade"]
          },
          "then": {
            "properties": {
              "raw_matches": { "type": "null" },
              "inliers": { "type": "null" },
              "inlier_ratio": { "type": "null" },
              "centroid_a": { "type": "null" },
              "centroid_b": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "grade": { "enum": ["ENOUGH", "WEAK", "LACK"] } },
            "required": ["grade"]
          },
          "then": {
            "properties": {
              "raw_matches": { "type": "integer", "minimum": 0 },
              "inliers": { "type": "integer", "minimum": 0 },
              "inlier_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "camera_guide_item": {
      "type": "object",
      "description": "약한·부족 쌍(5<=inliers<30)의 인라이어 무게중심 치우침(x>0.65 RIGHT, x<0.35 LEFT, y>0.68 DOWN, y<0.32 UP, 가로 우선) 또는 시야 미겹침(inliers<5)에 따른 카메라 회전 안내",
      "required": [
        "camera_id",
        "pair",
        "direction",
        "magnitude",
        "reason_code"
      ],
      "properties": {
        "camera_id": {
          "$ref": "../common/defs.schema.json#/$defs/camera_id"
        },
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "../common/defs.schema.json#/$defs/camera_id"
          },
          "description": "안내 근거가 된 카메라 쌍 [a, b]"
        },
        "direction": {
          "enum": ["LEFT", "RIGHT", "UP", "DOWN", "NONE"],
          "description": "카메라 회전 권장 방향 (inliers < 5 로 방향을 알 수 없으면 NONE)"
        },
        "magnitude": {
          "enum": ["SMALL", "MORE", "NONE"],
          "description": "회전 권장 크기 (WEAK 쌍은 SMALL, LACK 쌍은 MORE, direction 이 NONE 이면 NONE)"
        },
        "reason_code": {
          "enum": [
            "WEAK_PAIR_EDGE_CLUSTER",
            "NO_OVERLAP_VISIBLE",
            "OPTIONAL_IMPROVE"
          ],
          "description": "WEAK_PAIR_EDGE_CLUSTER: 가장자리에 겹침이 치우친 약한·부족 쌍, NO_OVERLAP_VISIBLE: inliers < 5 로 공통 시야 미관측, OPTIONAL_IMPROVE: 이미 CONNECTED 이지만 약한 쌍 보강 선택 안내"
        }
      },
      "additionalProperties": false
    }
  }
}
