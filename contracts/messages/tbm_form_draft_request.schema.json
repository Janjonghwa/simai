{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/tbm_form_draft_request.schema.json",
  "title": "EC2 내부 tbm_form_draft_request (1.0.0)",
  "description": "Spring → EC2 옆 Python 컨테이너(deploy/risk-engine). 날짜 작업 TBM 보고서 양식(report.form, S15P31A101-609)의 AI 초안 요청(S15P31A101-616). 【전송】 compose 내부망 HTTP/JSON, 공개 포트 없음, 봉투 없음. POST /v1/report/form-draft, 응답은 tbm_form_draft_result(200). 스키마·일관성 위반은 400(본문 없음), 본문 4 MiB 초과는 413. LLM 실패·검사 실패는 오류가 아니라 대체 초안(200, fallback true)이다. 【입력】 세팅 구역(관리자가 현장 세팅에서 정한 구역 이름·유형·규칙), 고른 작업내용(GET /api/work-tasks 의 code·label·rule_tags, 또는 직접 쓴 {text}), 그 합집합 규칙 태그, 날짜, 선택으로 이미 채운 칸(초안이 그것과 어긋나지 않게). 【외부 LLM 에 텍스트만】 리더·참석자·서명자 실명, 계정, 얼굴·영상·이미지·객체 주소, World ID·좌표는 싣지 않는다(모든 객체 닫힘, AGENTS 규칙 8, 명세 8.3 NFR-14). 구역 이름·직접 쓴 작업·이미 채운 칸은 관리자가 쓴 글자라 사람 이름을 넣지 않는 운영 기준에 기댄다. rule_tags 는 tasks 의 rule_tags 합집합과 같아야 한다(스키마 밖, 컨테이너가 400 으로 거절). 1.0.0 신설(S15P31A101-616).",
  "type": "object",
  "required": [
    "request_id",
    "report_date",
    "tasks",
    "rule_tags",
    "zones"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Spring 이 정한 요청 ID(예: rpt-<report_id>-r<form_revision>). 응답에 그대로 돌아온다"
    },
    "report_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "작업 날짜(현장 현지 날짜, YYYY-MM-DD)"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/task"
      },
      "description": "양식 info.tasks 순서 그대로. 작업내용 항목은 code·label·rule_tags, 직접 쓴 작업은 text 만"
    },
    "rule_tags": {
      "type": "array",
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rule_tag"
      },
      "description": "고른 작업내용 rule_tags 의 합집합(예전 공종 rule_tags 대신). 직접 쓴 작업만 있으면 빈 배열"
    },
    "zones": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/zone"
      },
      "description": "그 작업의 현장 세팅에서 발행한 구역. 없으면 빈 배열(장소는 비운다)"
    },
    "existing": {
      "$ref": "#/$defs/existing"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule_tag": {
      "type": "string",
      "pattern": "^R([1-9]|1[01])$",
      "description": "위험 규칙 ID(명세 7장 R1~R11)"
    },
    "task_code": {
      "enum": [
        "SLAB_OPENING_COVER",
        "WORK_PLATFORM",
        "FORMWORK",
        "REBAR",
        "MATERIAL_HANDLING",
        "EXTERIOR_SCAFFOLD_CHECK",
        "FLOOR_FINISHING"
      ],
      "description": "작업내용 항목 코드(서버 WorkTasks, GET /api/work-tasks)"
    },
    "task": {
      "type": "object",
      "description": "작업내용 한 줄: 작업내용 항목이면 code·label·rule_tags 셋, 직접 쓴 작업이면 text 하나만(섞지 않는다, 스키마)",
      "properties": {
        "code": {
          "$ref": "#/$defs/task_code"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "작업내용 항목 이름(서버 WorkTasks.label)"
        },
        "rule_tags": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rule_tag"
          },
          "description": "작업내용 항목 규칙 태그(서버 WorkTasks.rule_tags)"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "직접 쓴 작업(규칙 태그 없음)"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "text"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "code"
                  ]
                },
                {
                  "required": [
                    "label"
                  ]
                },
                {
                  "required": [
                    "rule_tags"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "code",
              "label",
              "rule_tags"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "required": [
        "name",
        "zone_kind",
        "rule_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "구역 표시 이름(관리자 등록)"
        },
        "zone_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "구역 유형(예: OPENING, FLOOR_EDGE, ELEVATED_WORK_SURFACE, EQUIPMENT_PARKING)"
        },
        "rule_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/rule_tag"
            },
            {
              "type": "null"
            }
          ],
          "description": "그 구역에 걸린 규칙. 모르면 null"
        }
      },
      "additionalProperties": false
    },
    "existing_pair": {
      "type": "object",
      "required": [
        "risk",
        "measure"
      ],
      "properties": {
        "risk": {
          "type": "string",
          "maxLength": 500
        },
        "measure": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "existing": {
      "type": "object",
      "description": "이미 채운 양식 칸(선택). 보낼 때는 초안이 채우는 칸을 모두 싣는다(빈 칸은 \"\"·null). 초안이 이 값과 어긋나지 않게 비지 않은 칸만 LLM 에 사실로 준다. Spring 은 이 값을 덮지 않는다(빈 칸만 채움)",
      "required": [
        "task_name",
        "place",
        "risk_assessed",
        "risks",
        "focus",
        "checks",
        "review"
      ],
      "properties": {
        "task_name": {
          "type": "string",
          "maxLength": 100
        },
        "place": {
          "type": "string",
          "maxLength": 200
        },
        "risk_assessed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "risks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/existing_pair"
          }
        },
        "focus": {
          "$ref": "#/$defs/existing_pair"
        },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "code",
              "yes",
              "action"
            ],
            "properties": {
              "code": {
                "$ref": "tbm_form_draft_result.schema.json#/$defs/check_code"
              },
              "yes": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "action": {
                "type": "string",
                "maxLength": 500
              }
            },
            "additionalProperties": false
          }
        },
        "review": {
          "type": "object",
          "required": [
            "daily"
          ],
          "properties": {
            "daily": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
