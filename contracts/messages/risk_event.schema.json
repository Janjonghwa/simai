{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/risk_event.schema.json",
  "title": "I2 risk_event",
  "description": "EC2 → 뷰어, STOMP /topic/events (명세 12.4, 12.2). EC2 가 저장한 RiskEvent 의 화면용 projection 이다. LIVE 는 Tier 0 전이(risk_event_transition)로만 갱신하고, PLANNED·REPLAY·WHAT_IF 는 EC2 옆 Risk Engine 컨테이너 결과로 보고서·시뮬레이션 화면에만 쓴다. rationale 은 VLM 결과가 오면 갱신으로 채워진다. VLM 은 proposed_severity 로 상향 의견만 내고 severity 를 바꾸지 못한다. 1.3.0 필드 추가(마이너): confidence_reasons(확인 필요 이유, 7.1), resume_count(해소 후 재개 횟수, 6.4). 2.0.0 의미 변경(메이저, Lead 승인 2026-10-20, S15P31A101-200): 운영자 종료 해소 resolution(선택, LIVE 만). resolution 이 있는 RESOLVED 는 verification VERIFIED 를 요구하지 않는다. 뷰어는 운영자 종료를 관측 해소와 구분해 보여 준다. 1.x 문서에는 resolution 이 없다(1.x 규칙 그대로). 2.1.0 필드 추가(마이너, S15P31A101-206): 운영자 상향 기록 escalations(선택, LIVE 만, 5.4·FR-116). /topic/events 화면 규칙(12.4): 경보 대상은 source LIVE·severity CRITICAL·HIGH·lifecycle RAISED·UPDATED 이고, 확인 상태는 acks 로 읽는다(지금 경보 단계 이후 event_sequence 를 대상으로 한 확인만 소리를 멈춘다, 3.10).",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "description": "운영자 종료 해소(resolution)는 2.0.0 부터다. 1.x 문서는 resolution 없이 1.x 규칙(RESOLVED 는 VERIFIED)으로 검사한다",
      "if": { "properties": { "schema_version": { "pattern": "^1[.]" } }, "required": ["schema_version"] },
      "then": { "properties": { "payload": { "not": { "required": ["resolution"] } } } }
    },
    {
      "description": "운영자 상향 기록(escalations)은 2.1.0 부터다",
      "if": { "properties": { "schema_version": { "pattern": "^(1[.]|2[.]0[.])" } }, "required": ["schema_version"] },
      "then": { "properties": { "payload": { "not": { "required": ["escalations"] } } } }
    }
  ],
  "type": "object",
  "properties": {
    "msg_type": { "const": "risk_event" },
    "payload": {
      "type": "object",
      "required": [
        "event_id", "rule_id", "rule_version", "source", "lifecycle", "verification", "severity",
        "confidence", "needs_check", "world_ids", "zone_id", "metrics", "rationale", "proposed_severity"
      ],
      "properties": {
        "event_id": { "$ref": "../common/defs.schema.json#/$defs/uuid_v7" },
        "event_sequence": { "type": "integer", "minimum": 1, "description": "반영한 마지막 전이의 sequence (LIVE)" },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "../common/defs.schema.json#/$defs/risk_origin" },
        "lifecycle": { "$ref": "../common/defs.schema.json#/$defs/risk_lifecycle" },
        "verification": { "$ref": "../common/defs.schema.json#/$defs/risk_verification" },
        "severity": {
          "$ref": "../common/defs.schema.json#/$defs/severity",
          "description": "규칙 결과. VLM 의견으로 바뀌지 않는다. 상향은 검증된 규칙 조건이나 운영자 확인을 거쳐 새 전이로만 반영한다 (5.4)"
        },
        "confidence": { "$ref": "../common/defs.schema.json#/$defs/risk_confidence" },
        "needs_check": { "type": "boolean", "description": "확인 필요 (7.1). confidence_reasons 가 있으면 그 목록이 비어 있지 않은 것과 같다" },
        "confidence_reasons": {
          "$ref": "../common/defs.schema.json#/$defs/confidence_reasons",
          "description": "확인 필요의 이유 (명세 7.1, 13.2 화면 표시, 1.3.0). 없으면(이전 버전) needs_check 만으로 읽는다"
        },
        "resume_count": {
          "type": "integer",
          "minimum": 0,
          "description": "해소 후 재개 시간 안 재발생으로 이 이벤트를 다시 활성으로 돌린 횟수 (6.4 이벤트 재개, 1.3.0). LIVE 는 resumed 전이 수와 같다. 없으면 0"
        },
        "world_ids": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/world_id" },
          "uniqueItems": true
        },
        "zone_id": { "type": ["string", "null"], "minLength": 1 },
        "metrics": { "$ref": "../common/defs.schema.json#/$defs/rule_metrics" },
        "rationale": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "VLM 근거 문장. 아직 없으면 null. 이벤트 상세 화면에만 쓰고 푸시를 다시 보내지 않는다 (10.1)"
        },
        "proposed_severity": {
          "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/severity" }, { "type": "null" }],
          "description": "VLM 상향 의견. severity 보다 높은 등급만 허용, 하향·해소 의견은 표현할 수 없다"
        },
        "gateway_id": { "$ref": "../common/defs.schema.json#/$defs/instance_id", "description": "LIVE 이벤트를 만든 Tier 0 인스턴스" },
        "config_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
        "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
        "scene_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
        "raised_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
        "updated_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
        "resolved_at": { "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" }, { "type": "null" }] },
        "acks": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/operator_ack" },
          "description": "운영자 확인 기록(누가·어디서). 비어 있으면 미확인. 확인은 해소가 아니다"
        },
        "delivery": {
          "enum": ["REALTIME", "DELAYED_ACTIVE", "AUDIT_ONLY"],
          "description": "LIVE 전달 구분 (3.2 재동기화). DELAYED_ACTIVE: 재동기화 후에도 활성이라 지연 알림. AUDIT_ONLY: 재동기화 중 해소돼 감사 기록으로만 복원"
        },
        "related_event_id": { "$ref": "../common/defs.schema.json#/$defs/uuid_v7" },
        "resolution": {
          "$ref": "../common/defs.schema.json#/$defs/operator_resolution",
          "description": "운영자 종료 해소(2.0.0, 6.4). LIVE 의 RESOLVED 에만. 없으면 관측 해소다"
        },
        "escalations": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/operator_escalation" },
          "description": "운영자 상향 기록(2.1.0, 5.4·FR-116). 비어 있거나 없으면 상향 없음. LIVE 만. 뷰어는 규칙 판정 등급과 운영자 상향을 구분해 보여 준다"
        }
      },
      "allOf": [
        { "$ref": "../common/defs.schema.json#/$defs/severity_upward_only" },
        { "$ref": "../common/defs.schema.json#/$defs/needs_check_matches_reasons" },
        {
          "description": "관측 해소는 관측으로 확인했을 때만 (6.4). 운영자 종료(resolution)는 검증 상태를 바꾸지 않는다 (2.0.0)",
          "if": { "properties": { "lifecycle": { "const": "RESOLVED" } }, "required": ["lifecycle"], "not": { "required": ["resolution"] } },
          "then": { "properties": { "verification": { "const": "VERIFIED" } } }
        },
        {
          "description": "resolution 은 LIVE 의 RESOLVED 에만 (2.0.0)",
          "if": { "required": ["resolution"] },
          "then": { "properties": { "lifecycle": { "const": "RESOLVED" }, "source": { "const": "LIVE" } }, "required": ["lifecycle", "source"] }
        },
        {
          "description": "운영자 상향 기록은 LIVE 에만 (2.1.0)",
          "if": { "required": ["escalations"] },
          "then": { "properties": { "source": { "const": "LIVE" } }, "required": ["source"] }
        },
        {
          "description": "delivery 는 알림 대상인 LIVE 이벤트에만 있다 (7.4 출처 분리)",
          "if": { "properties": { "source": { "not": { "const": "LIVE" } } }, "required": ["source"] },
          "then": { "not": { "required": ["delivery"] } }
        }
      ]
    }
  }
}
