{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/health.schema.json",
  "title": "I1 health",
  "description": "RunPod Tier 0 → EC2, 1 Hz (명세 12.3, 3.11, 6.2). EC2 는 이 메시지를 Tier 0 하트비트로도 쓴다. 같은 형식을 I0 제어 채널로 노트북에도 보낸다(12.2 I0 아래로 health). 손실은 세 값(camera_to_gateway_gap, gateway_to_runpod_loss, skipped_by_policy)을 따로 보고한다 (12.7, 5.1). I1 LIVE 계약.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "properties": {
    "msg_type": { "const": "health" },
    "payload": {
      "type": "object",
      "required": ["system_health", "cameras", "pipeline_lag_ms", "calibration_state"],
      "properties": {
        "system_health": { "$ref": "../common/defs.schema.json#/$defs/system_health" },
        "t_latest_global": {
          "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" }, { "type": "null" }],
          "description": "처리된 유효 프레임이 없으면 null (6.1)"
        },
        "cameras": { "type": "array", "items": { "$ref": "#/$defs/camera_health" } },
        "pipeline_lag_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms", "description": "T_lag = t_risk_now - t_latest_global (6.1)" },
        "capture_to_risk_ms": { "$ref": "../common/defs.schema.json#/$defs/percentiles_ms", "description": "보고 구간의 촬영 → 판정 지연 (6.6)" },
        "calibration_state": { "$ref": "../common/defs.schema.json#/$defs/calibration_state" },
        "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
        "config_version": { "$ref": "../common/defs.schema.json#/$defs/version_id", "description": "현재 적용 중인 구성 묶음" },
        "config_sync": { "$ref": "../common/defs.schema.json#/$defs/config_sync" },
        "gateway_link": {
          "$ref": "../common/defs.schema.json#/$defs/link_state",
          "description": "노트북(I0 제어 채널) 연결 상태. 끊기면 UNSAFE_UNKNOWN"
        },
        "gpu_util": { "type": "number", "minimum": 0, "maximum": 1 },
        "gpu_memory_used_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },

  "$defs": {
    "camera_health": {
      "type": "object",
      "required": ["id", "fps", "last_capture", "sync_offset_ms", "status"],
      "properties": {
        "id": { "$ref": "../common/defs.schema.json#/$defs/camera_id", "description": "camera_id (12.3 예시의 필드 이름을 따름)" },
        "fps": { "type": "number", "minimum": 0, "description": "추론한 프레임 기준 처리 FPS" },
        "last_capture": {
          "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" }, { "type": "null" }],
          "description": "마지막으로 처리한 프레임의 촬영 시각. 받은 적 없으면 null"
        },
        "sync_offset_ms": { "type": ["number", "null"], "description": "다른 카메라 대비 시각 오프셋 (3.9). 잴 수 없으면 null" },
        "status": {
          "enum": ["OK", "NO_SIGNAL", "WAITING_KEYFRAME", "SYNC_INVALID"],
          "description": "NO_SIGNAL: 수신 중단. WAITING_KEYFRAME: 재접속 후 코덱 정보·키프레임 대기(관측 없음, 12.7). SYNC_INVALID: 시간 동기화 무효로 융합 제외(6.5)"
        },
        "stream_epoch": { "type": "integer", "minimum": 0 },
        "timestamp_source": { "$ref": "../common/defs.schema.json#/$defs/timestamp_source" },
        "timestamp_uncertainty_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms" },
        "frame_age_ms": { "$ref": "../common/defs.schema.json#/$defs/percentiles_ms", "description": "촬영 → 추론 시점 전체 경과 (5.1)" },
        "queue_wait_ms": { "$ref": "../common/defs.schema.json#/$defs/percentiles_ms", "description": "추론 대기열 대기 시간 (5.1)" },
        "max_result_gap_ms": { "$ref": "../common/defs.schema.json#/$defs/duration_ms", "description": "보고 구간의 최대 결과 간격 (5.1)" },
        "frames": {
          "type": "object",
          "description": "보고 구간(직전 health 이후)의 프레임 집계. 세 손실 값을 섞지 않는다",
          "required": ["received", "gateway_to_runpod_loss", "skipped_by_policy"],
          "properties": {
            "received": { "type": "integer", "minimum": 0 },
            "gateway_to_runpod_loss": { "type": "integer", "minimum": 0, "description": "frame_sequence 빈 구간 (NETWORK_LOSS). G0 손실률에 넣는 값" },
            "skipped_by_policy": { "type": "integer", "minimum": 0, "description": "latest-frame-wins 로 건너뛴 프레임. 손실이 아니다" },
            "late_dropped": { "type": "integer", "minimum": 0, "description": "시간 보간 창을 넘겨 도착해 버린 프레임" },
            "camera_to_gateway_gap_max_ms": {
              "$ref": "../common/defs.schema.json#/$defs/duration_ms",
              "description": "노트북이 laptop_heartbeat 로 알린 카메라 → 노트북 도착 간격의 최대값"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
