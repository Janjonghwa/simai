{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/site_setup.schema.json",
  "title": "I5 site_setup 1.7.0 입력·단계·결과",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "setup_session_id",
        "work_unit_id",
        "site_id",
        "camera_heights_m",
        "calibration_target",
        "height_tolerance_cm"
      ],
      "properties": {
        "setup_session_id": {
          "$ref": "../common/defs.schema.json#/$defs/uuid"
        },
        "work_unit_id": {
          "type": "integer",
          "minimum": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "camera_heights_m": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "calibration_target": {
          "type": "object",
          "required": [
            "camera_ids",
            "method",
            "world_frame"
          ],
          "properties": {
            "camera_ids": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "method": {
              "const": "BACKGROUND_JOINT_BA_V2"
            },
            "world_frame": {
              "const": "AUTO_FLOOR_Z_UP_METERS"
            }
          },
          "additionalProperties": false
        },
        "height_tolerance_cm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": [
        "setup_session_id",
        "status",
        "progress_pct"
      ],
      "properties": {
        "setup_session_id": {
          "$ref": "../common/defs.schema.json#/$defs/uuid"
        },
        "status": {
          "enum": [
            "COLLECTING_BACKGROUND",
            "INITIAL_POSE_AND_WORLD",
            "JOINT_BA_AND_VERIFY",
            "PREVIEW_AND_VLM_DRAFT",
            "READY_FOR_ZONES",
            "BAKING_TEXTURE",
            "COMPLETED"
          ]
        },
        "progress_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "background_collection_pct": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "calibration_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "preview_scene_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scene_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "config_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "zone_drafts_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "height_checks": {
          "$ref": "#/$defs/height_checks"
        },
        "scale_source": {
          "$ref": "../providers/calibration.schema.json#/$defs/scale_source"
        },
        "scale_estimation": {
          "$ref": "../providers/calibration.schema.json#/$defs/scale_estimation"
        },
        "object_cross_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "passed"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "TRAFFIC_CONE",
                  "OPENING_SIGN"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "measured_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "expected_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "residual_cm": {
                "type": "number"
              },
              "floor_z_m": {
                "type": "number"
              },
              "cameras": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "../common/defs.schema.json#/$defs/camera_id"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "artifacts": {
          "$ref": "#/$defs/artifacts"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "READY_FOR_ZONES",
                  "BAKING_TEXTURE",
                  "COMPLETED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "calibration_version",
              "preview_scene_version",
              "height_checks"
            ]
          }
        }
      ],
      "description": "site_setup 1.3.0 상태 스냅샷. 서버는 세션·카메라 집합, 높이 입력·차이(cm, 복원-입력)·허용값, 버전의 현장·보정 계보를 확인한다. 진행 순서·진행률은 동일 대여에서 감소할 수 없다. 자동 재대여 시 새 대여의 첫 스냅샷부터 다시 시작한다. 버전 참조는 이미 등록된 버전(다른 세팅 세션에 귀속된 버전은 제외)이거나, 같은 스냅샷의 artifacts 로 이 세션이 등록하는 버전만 허용한다(1.2.0). config_version 은 EC2 가 연결한다: 구역 발행 때, 그리고 세팅 결과(COMPLETED) 성공 시 이 세션이 등록한 새 보정을 실은 구성 묶음을 발행할 때(1.2.0). 선택 metrics(1.1.0, S15P31A101-465)는 단계별 소요 시간(stage_seconds)·총 시간·Stage A 회전 BA 지표를 기록한다. 선택 artifacts(1.2.0, S15P31A101-467)는 새 보정 문서·미리보기/정식 GLB 객체 참조다. artifacts.camera_frames(1.3.0, S15P31A101-479)는 AI 구역 초안(vlm_zone_draft)의 VLM 크롭 입력이 되는 카메라별 대표 프레임 객체 참조다."
    },
    "result": {
      "type": "object",
      "required": [
        "setup_session_id",
        "status",
        "progress_pct",
        "calibration_version",
        "preview_scene_version",
        "scene_version",
        "height_checks"
      ],
      "properties": {
        "setup_session_id": {
          "$ref": "../common/defs.schema.json#/$defs/uuid"
        },
        "status": {
          "const": "COMPLETED"
        },
        "progress_pct": {
          "const": 100
        },
        "background_collection_pct": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "calibration_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "preview_scene_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scene_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160,
          "description": "정식 굽기(BAKING_TEXTURE)를 끝내지 못하고 작업 시작(LIVE)으로 회수했을 때만 null 이다(1.7.0, S15P31A101-597). null 이면 bake_skipped 가 필수이고 artifacts.scene 을 싣지 않는다. 관제는 이미 현재 Scene 인 미리보기(preview_scene_version)로 한다"
        },
        "config_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "zone_drafts_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "height_checks": {
          "$ref": "#/$defs/height_checks"
        },
        "scale_source": {
          "$ref": "../providers/calibration.schema.json#/$defs/scale_source"
        },
        "scale_estimation": {
          "$ref": "../providers/calibration.schema.json#/$defs/scale_estimation"
        },
        "object_cross_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "passed"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "TRAFFIC_CONE",
                  "OPENING_SIGN"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "measured_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "expected_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "residual_cm": {
                "type": "number"
              },
              "floor_z_m": {
                "type": "number"
              },
              "cameras": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "../common/defs.schema.json#/$defs/camera_id"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "bake_skipped": {
          "enum": ["LIVE_WORK_STARTED"],
          "description": "1.7.0 선택(S15P31A101-597): 정식 굽기를 건너뛴 이유. LIVE_WORK_STARTED = 굽는 중(또는 굽기 전)에 같은 현장 작업이 시작돼(EC2 job_lease_status.live_work_active) 명세 3.2 대로 굽기 자원을 회수했다. 있으면 scene_version 은 null 이다"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "artifacts": {
          "$ref": "#/$defs/artifacts"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "1.7.0: 정식 Scene 이 없으면(scene_version null) 건너뛴 이유가 있어야 하고 정식 GLB 를 싣지 않는다",
          "if": { "properties": { "scene_version": { "type": "null" } }, "required": ["scene_version"] },
          "then": { "required": ["bake_skipped"], "properties": { "artifacts": { "not": { "required": ["scene"] } } } }
        },
        {
          "description": "1.7.0: 건너뛴 이유가 있으면 정식 Scene 이 없다",
          "if": { "required": ["bake_skipped"] },
          "then": { "properties": { "scene_version": { "type": "null" } } }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "READY_FOR_ZONES",
                  "BAKING_TEXTURE",
                  "COMPLETED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "calibration_version",
              "preview_scene_version",
              "height_checks"
            ]
          }
        }
      ],
      "description": "site_setup 1.3.0 상태 스냅샷. 서버는 세션·카메라 집합, 높이 입력·차이(cm, 복원-입력)·허용값, 버전의 현장·보정 계보를 확인한다. 진행 순서·진행률은 동일 대여에서 감소할 수 없다. 자동 재대여 시 새 대여의 첫 스냅샷부터 다시 시작한다. 버전 참조는 이미 등록된 버전(다른 세팅 세션에 귀속된 버전은 제외)이거나, 같은 스냅샷의 artifacts 로 이 세션이 등록하는 버전만 허용한다(1.2.0). config_version 은 EC2 가 연결한다: 구역 발행 때, 그리고 세팅 결과(COMPLETED) 성공 시 이 세션이 등록한 새 보정을 실은 구성 묶음을 발행할 때(1.2.0). 선택 metrics(1.1.0, S15P31A101-465)는 단계별 소요 시간(stage_seconds)·총 시간·Stage A 회전 BA 지표를 기록한다. 선택 artifacts(1.2.0, S15P31A101-467)는 새 보정 문서·미리보기/정식 GLB 객체 참조다. artifacts.camera_frames(1.3.0, S15P31A101-479)는 AI 구역 초안(vlm_zone_draft)의 VLM 크롭 입력이 되는 카메라별 대표 프레임 객체 참조다."
    },
    "height_checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "input_height_m",
          "restored_height_m",
          "difference_cm",
          "within_tolerance"
        ],
        "properties": {
          "input_height_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "restored_height_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "difference_cm": {
            "type": "number"
          },
          "within_tolerance": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "stage_seconds": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "COLLECTING_BACKGROUND",
              "INITIAL_POSE_AND_WORLD",
              "JOINT_BA_AND_VERIFY",
              "PREVIEW_AND_VLM_DRAFT",
              "READY_FOR_ZONES",
              "BAKING_TEXTURE"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "joint_ba": {
          "type": "object",
          "required": [
            "anchor_camera_id",
            "converged",
            "stage_seconds",
            "valid_points"
          ],
          "properties": {
            "anchor_camera_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "converged": {
              "type": "boolean"
            },
            "stage_seconds": {
              "type": "number",
              "minimum": 0
            },
            "valid_points": {
              "type": "integer",
              "minimum": 0
            },
            "holdout_worsening_tolerance_px": {"type": "number", "minimum": 0},
            "pair_holdout": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["before", "after"],
                "properties": {
                  "before": {"$ref": "#/$defs/holdout_stats"},
                  "after": {"$ref": "#/$defs/holdout_stats"}
                },
                "additionalProperties": false
              }
            },
            "pair_holdout_median_px": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]{1,64}-[A-Za-z0-9_-]{1,64}$"
              },
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            },
            "scale_source": {
              "$ref": "../providers/calibration.schema.json#/$defs/scale_source"
            },
            "scale_estimation": {
              "$ref": "../providers/calibration.schema.json#/$defs/scale_estimation"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "holdout_stats": {
      "type": "object",
      "required": ["n", "invalid", "median", "p90", "p95"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0},
        "median": {"type": ["number", "null"], "minimum": 0},
        "p90": {"type": ["number", "null"], "minimum": 0},
        "p95": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "object_ref": {
      "type": "object",
      "required": [
        "uri",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^s3://[^\\s]+$",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "description": "워커가 이 작업·이 대여의 서명 PUT(POST /api/worker/jobs/{job_id}/objects/sign)으로 올린 객체. uri 는 서명 응답의 s3:// 주소 그대로, sha256 은 올린 바이트의 SHA-256 16진수(서명에 묶은 값), size_bytes 는 올린 바이트 수."
    },
    "camera_frame_ref": {
      "type": "object",
      "required": [
        "camera_id",
        "uri",
        "sha256",
        "face_policy"
      ],
      "properties": {
        "camera_id": {
          "$ref": "../common/defs.schema.json#/$defs/camera_id"
        },
        "uri": {
          "type": "string",
          "pattern": "^s3://[^\\s]+$",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "face_policy": {
          "enum": [
            "BLURRED",
            "EXCLUDED"
          ],
          "description": "vlm_zone_draft 입력 frames[].face_policy 로 그대로 간다(OBSERVED 금지, AGENTS 규칙 8). 사람 지운 배경이라 얼굴은 원칙상 없지만, VLM 워커가 이 값대로 얼굴 흐림 관문을 거친다."
        }
      },
      "additionalProperties": false,
      "description": "1.3.0(S15P31A101-479): 카메라 하나의 대표 프레임. uri·sha256·size_bytes 는 object_ref 와 같은 뜻(이 작업·이 대여의 서명 PUT 로 올린 JPEG)이다."
    },
    "bake_image_ref": {
      "type": "object",
      "required": [
        "camera_id",
        "uri",
        "sha256",
        "face_policy"
      ],
      "properties": {
        "camera_id": {
          "$ref": "../common/defs.schema.json#/$defs/camera_id"
        },
        "uri": {
          "type": "string",
          "pattern": "^s3://[^\\s]+$",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "face_policy": {
          "enum": [
            "OBSERVED",
            "BLURRED",
            "EXCLUDED"
          ],
          "description": "사진의 얼굴 정책(AGENTS 규칙 8). 같은 사진이 GLB 텍스처로 이미 구워졌으므로 외형 텍스처와 같은 규칙을 따른다(기본 OBSERVED: 관측 픽셀 그대로, 생성형 복원 없음)."
        }
      },
      "additionalProperties": false,
      "description": "1.6.0(S15P31A101-593): 카메라 하나의 굽기 입력 사진. uri·sha256·size_bytes 는 object_ref 와 같은 뜻(이 작업·이 대여의 서명 PUT 로 올린 JPEG)이다."
    },
    "bake_images": {
      "type": "object",
      "required": [
        "bundle_id",
        "images"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^bundle-[0-9a-f]{32}$",
          "description": "이 대여가 미리보기·굽기에 쓴 Tier 0 사람 지운 배경 묶음 ID(clean-background/<calibration_version>/bundle-<uuid>)"
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/bake_image_ref"
          },
          "description": "카메라마다 최대 하나(카메라 ID 는 세션 카메라 안)"
        }
      },
      "additionalProperties": false,
