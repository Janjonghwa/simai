{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/recording_upload_progress.schema.json",
  "title": "기기 POST /api/devices/recordings/progress. 끝난 작업의 녹화별 진행 보고. 등록 수는 video_segment에서 센다. 같은 녹화의 최신 보고로 갱신.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "recording_id",
    "expected_segments",
    "failed_segments",
    "sealed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_id": {
      "type": "integer",
      "minimum": 1
    },
    "recording_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "expected_segments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "failed_segments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "sealed": {
      "type": "boolean",
      "description": "모든 카메라가 작업 끝 이후까지 파일을 닫았거나 녹화 세션이 종료되어 조각 계획이 확정됨"
    }
  }
}
