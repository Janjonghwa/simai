{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/tbm_form_ending_request.schema.json",
  "title": "EC2 내부 tbm_form_ending_request (1.0.0)",
  "description": "Spring → EC2 옆 Python 컨테이너(deploy/risk-engine). 작업 종료 때 양식 review.ending(종료 미팅, B10) 문장 요청(S15P31A101-616). 【전송】 compose 내부망 HTTP/JSON, 공개 포트 없음, 봉투 없음. POST /v1/report/form-ending, 응답은 tbm_form_ending_result(200). 스키마·일관성 위반은 400, 본문 4 MiB 초과는 413. 【입력】 기존 작업 마무리(POST /v1/report/wrap-up, docs/design/work-start-end-wrapup.md)와 같은 집계 사실 facts: 서버가 작업 종료 때 실제 진행 구간·대상 구역의 LIVE risk_event 를 모은 숫자(명세 8.3)뿐이다. 사람 이름·작업명·구역 ID·영상·좌표는 싣지 않는다(닫힌 객체). 합계 일관성(등급·규칙·시간대 합 = event_count, 미확인 CRITICAL ≤ CRITICAL, 구역 건수 내림차순 등)은 스키마 밖이고 컨테이너가 400 으로 거절한다. 1.0.0 신설(S15P31A101-616).",
  "type": "object",
  "required": ["request_id", "window_ms", "facts"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$" },
    "window_ms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0, "maximum": 253402300799999 },
      "description": "[실제 시작, 실제 종료] UTC ms. 시작 ≤ 종료(스키마 밖)"
    },
    "facts": { "$ref": "#/$defs/facts" }
  },
  "additionalProperties": false,
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "facts": {
      "type": "object",
      "required": ["event_count", "severity_counts", "rule_counts", "max_severity", "operator_ack_count", "operator_close_count",
                   "outside_work_entry_count", "unacknowledged_critical_count", "phase_counts", "first_event_min", "last_event_min", "top_zones"],
      "properties": {
        "event_count": { "$ref": "#/$defs/count" },
        "severity_counts": {
          "type": "object",
          "required": ["CRITICAL", "HIGH", "CAUTION", "INFO"],
          "properties": {
            "CRITICAL": { "$ref": "#/$defs/count" },
            "HIGH": { "$ref": "#/$defs/count" },
            "CAUTION": { "$ref": "#/$defs/count" },
            "INFO": { "$ref": "#/$defs/count" }
          },
          "additionalProperties": false
        },
        "rule_counts": {
          "type": "object",
          "propertyNames": { "pattern": "^R([1-9]|1[01])$" },
          "additionalProperties": { "$ref": "#/$defs/count" },
          "description": "규칙 ID(R1~R11)별 건수"
        },
        "max_severity": { "enum": ["CRITICAL", "HIGH", "CAUTION", "INFO", null] },
        "operator_ack_count": { "$ref": "#/$defs/count" },
        "operator_close_count": { "$ref": "#/$defs/count" },
        "outside_work_entry_count": { "$ref": "#/$defs/count" },
        "unacknowledged_critical_count": { "$ref": "#/$defs/count" },
        "phase_counts": {
          "type": "object",
          "required": ["early", "middle", "late"],
          "properties": {
            "early": { "$ref": "#/$defs/count" },
            "middle": { "$ref": "#/$defs/count" },
            "late": { "$ref": "#/$defs/count" }
          },
          "additionalProperties": false
        },
        "first_event_min": { "type": ["integer", "null"], "minimum": 0 },
        "last_event_min": { "type": ["integer", "null"], "minimum": 0 },
        "top_zones": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "count"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "count": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
