{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/observation_batch.schema.json",
  "title": "I1 observation_batch",
  "description": "RunPod Tier 0 → EC2, 묶음 전송. 카메라별 2D 관측(observation_2d: 촬영 시각, 카메라, 카메라 내 트랙, bbox, keypoint)을 Spatial DB 에 남긴다 (명세 12.2, 11.2, 5.1). 보정 재계산과 TIER0_LOG WorldTrackProvider(20.4)의 입력이다. 저장 주기는 5~15 Hz 로 처리 주기보다 낮을 수 있다. I1 LIVE 계약.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "properties": {
    "msg_type": { "const": "observation_batch" },
    "payload": {
      "type": "object",
      "required": ["calibration_version", "joint_layout", "frames"],
      "properties": {
        "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
        "joint_layout": { "$ref": "../common/defs.schema.json#/$defs/joint_layout", "description": "keypoints_2d 의 관절 순서" },
        "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/frame_observation" } }
      }
    }
  },

  "$defs": {
    "frame_observation": {
      "description": "프레임 하나의 관측. 프레임 식별자와 촬영 시각은 I0 프레임 헤더 값을 그대로 쓴다 (12.7, 3.9)",
      "allOf": [
        { "$ref": "../common/defs.schema.json#/$defs/frame_key" },
        { "$ref": "../common/defs.schema.json#/$defs/capture_time" }
      ],
      "type": "object",
      "required": ["detections"],
      "properties": {
        "detections": {
          "type": "array",
          "description": "이 프레임의 사람 검출. 사람이 없으면 빈 배열(프레임은 처리됨)",
          "items": { "$ref": "#/$defs/detection" }
        }
      }
    },
    "detection": {
      "type": "object",
      "required": ["local_track_id", "bbox", "score", "keypoints_2d"],
      "properties": {
        "local_track_id": {
          "type": "string",
          "minLength": 1,
          "description": "카메라 내 트랙 ID(카메라별 ByteTrack). 사람 정체성의 정본이 아니다"
        },
        "bbox": { "$ref": "../common/defs.schema.json#/$defs/bbox_xyxy" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "keypoints_2d": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/keypoint_2d" },
          "description": "joint_layout 순서. 검출되지 않은 관절은 null"
        },
        "world_id": {
          "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/world_id" }, { "type": "null" }],
          "description": "카메라 간 연결 결과. 아직 연결되지 않았으면 null"
        }
      }
    }
  }
}
