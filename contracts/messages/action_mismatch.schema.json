{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/action_mismatch.schema.json",
  "title": "I2 action_mismatch",
  "description": "EC2 → 관리자 뷰어, STOMP /topic/admin/events (명세 8.4, 12.2, FR-42). 반장이 조치 티켓을 완료했는데 연결된 LIVE 이벤트가 관측상 아직 활성이면 보내는 불일치 표시다. 조치 완료는 사람의 보고이고 이벤트 해소가 아니다. 이벤트가 해소되면 cleared true 로 한 번 더 보낸다. 이 토픽은 관리자 권한만 구독한다. 1.0.0 신설(S15P31A101-206).",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "properties": {
    "msg_type": { "const": "action_mismatch" },
    "payload": {
      "type": "object",
      "required": ["ticket_id", "event_id", "event_sequence", "ticket_status", "event_lifecycle", "detected_at", "cleared"],
      "properties": {
        "ticket_id": { "type": "string", "minLength": 1 },
        "event_id": { "$ref": "../common/defs.schema.json#/$defs/uuid_v7" },
        "event_sequence": { "type": "integer", "minimum": 1, "description": "불일치를 판단한 이벤트 상태" },
        "ticket_status": { "const": "DONE", "description": "조치 완료" },
        "event_lifecycle": { "$ref": "../common/defs.schema.json#/$defs/risk_lifecycle" },
        "zone_id": { "type": ["string", "null"], "minLength": 1 },
        "detected_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
        "cleared": { "type": "boolean", "description": "false: 불일치 발생. true: 이벤트 해소로 불일치가 풀림" }
      },
      "allOf": [
        {
          "description": "불일치는 이벤트가 활성일 때만 생긴다",
          "if": { "properties": { "cleared": { "const": false } }, "required": ["cleared"] },
          "then": { "properties": { "event_lifecycle": { "enum": ["RAISED", "UPDATED"] } } }
        }
      ]
    }
  }
}
