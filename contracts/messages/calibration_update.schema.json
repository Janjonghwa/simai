{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/calibration_update.schema.json",
  "title": "I1 calibration_update",
  "description": "RunPod Tier 0 → EC2. 보정 상태나 버전이 바뀔 때 보낸다 (명세 12.2, 4.4, 4.5). 보정 전체는 CalibrationProvider 출력 문서(contracts/providers/calibration.schema.json)의 주소와 해시로 참조한다. 2.1.0부터 Scene 정합 비교용 World→camera R·t를 선택 camera_poses에 함께 실을 수 있다(K·왜곡은 문서만 참조). 새 버전은 원자적으로 전환하고 덮어쓰지 않는다. 2.0.0 의미 변경(메이저): provider_source 값에서 v1.3 에서 쓰지 않는 마커 보정·평면도 대응점 출처를 뺐다(common/defs calibration_source). I1 LIVE 계약. 2.1.0: 선택 world_frame_id·camera_poses 추가(S15P31A101-381, Lead 승인 필요).",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "properties": {
    "msg_type": { "const": "calibration_update" },
    "payload": {
      "type": "object",
      "required": [
        "calibration_version", "previous_calibration_version", "calibration_state", "provider_source",
        "reason", "effective_at", "calibration_ref", "calibration_hash"
      ],
      "properties": {
        "world_frame_id": {"$ref": "../common/defs.schema.json#/$defs/version_id", "description": "World를 고정한 bootstrap 보정 ID. 실행 중 후보·되돌림·재시작에서 계승하며 같은 현장만으로 같다고 추정하지 않는다."},
        "camera_poses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["camera_id", "R", "t"], "properties": {"camera_id": {"$ref": "../common/defs.schema.json#/$defs/camera_id"}, "R": {"$ref": "../common/defs.schema.json#/$defs/mat3"}, "t": {"$ref": "../common/defs.schema.json#/$defs/vec3"}}, "additionalProperties": false}, "description": "이 버전의 World→camera 자세. Scene 생성 보정 대비 누적 변화 계산용이며 위치 정본을 대체하지 않는다."},
        "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
        "previous_calibration_version": {
          "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/version_id" }, { "type": "null" }],
          "description": "첫 보정이면 null"
        },
        "calibration_state": { "$ref": "../common/defs.schema.json#/$defs/calibration_state" },
        "provider_source": { "$ref": "../common/defs.schema.json#/$defs/calibration_source" },
        "reason": {
          "enum": ["INITIAL", "RECALIBRATED", "STATE_CHANGED", "DRIFT_DETECTED", "STREAM_CHANGED"],
          "description": "STREAM_CHANGED: 스트림 해상도·화각 변경 (4.4 DRIFTED 조건)"
        },
        "effective_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms", "description": "Tier 0 가 이 버전으로 전환한 시각" },
        "calibration_ref": { "$ref": "../common/defs.schema.json#/$defs/uri", "description": "CalibrationProvider 출력 문서 주소" },
        "calibration_hash": { "$ref": "../common/defs.schema.json#/$defs/sha256" },
        "cameras": {
          "type": "array",
          "description": "카메라별 운영 중 재투영 오차 (4.5: 지나가는 사람의 keypoint 로 계속 계산)",
          "items": {
            "type": "object",
            "required": ["camera_id", "reprojection_error_px"],
            "properties": {
              "camera_id": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
              "reprojection_error_px": {
                "type": "object",
                "required": ["median", "p95"],
                "properties": {
                  "median": { "type": "number", "minimum": 0 },
                  "p95": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "description": "공개 데이터 정답·시뮬레이터·모델 추정 카메라는 CALIBRATED 가 될 수 없다 (명세 20.4 규칙 4, calibration.schema.json 과 같은 규칙)",
          "if": {
            "properties": { "provider_source": { "enum": ["DATASET_GT", "SIM", "MODEL_ESTIMATE"] } },
            "required": ["provider_source"]
          },
          "then": { "properties": { "calibration_state": { "enum": ["UNCALIBRATED", "PROVISIONAL"] } } }
        }
      ]
    }
  }
}
