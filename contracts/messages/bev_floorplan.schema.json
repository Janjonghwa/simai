{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/bev_floorplan.schema.json",
  "title": "I5 bev_floorplan 입력·결과",
  "description": "I5 job_type bev_floorplan 의 입력(job_request.payload.input, 3.2.0)과 결과(job_callback.payload.result, 2.2.0) (명세 4.1 BEV 평면도, 12.5, FR-22, S15P31A101-239). BEV 평면도는 보조 화면이다: 좌표·스케일의 기준이 아니고 정확도 목표가 없으며 안전 판단에 쓰지 않는다(purpose·safety_use 고정). 사람은 그리지 않는다. 이미지·보정 문서·프레임은 객체 저장소 주소(s3://)로만 주고받고, 워커는 대여에 묶인 워커 전용 서명 API 로 받고 올린다(S15P31A101-248). 이 파일은 정의만 담고 메시지는 job_request·job_callback 이다.",
  "$defs": {
    "input": {
      "type": "object",
      "description": "EC2 가 CALIBRATED 가 되거나 보정 버전이 바뀌면 등록한다(12.5). 보정 문서는 calibration_ref 에서 받아 calibration_hash 로 확인한다(다르면 재시도 불가 FAILED)",
      "required": ["calibration_version", "calibration_ref", "calibration_hash", "frame_source", "frames"],
      "properties": {
        "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
        "calibration_ref": { "$ref": "../common/defs.schema.json#/$defs/object_uri", "description": "CalibrationProvider 출력 문서(calibration.schema.json) 주소. calibration_update.calibration_ref 와 같다" },
        "calibration_hash": { "$ref": "../common/defs.schema.json#/$defs/sha256", "description": "보정 문서 바이트의 sha256. calibration_update.calibration_hash 와 같다" },
        "frame_source": { "$ref": "../common/defs.schema.json#/$defs/frame_source", "description": "프레임 출처. 결과 input_provenance.frames.source 로 그대로 간다(SIM 이면 상한 결과)" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "description": "카메라마다 사람 없는 프레임 한 장(같은 camera_id 두 장은 워커가 거부한다). 사람이 찍히면 바닥에 늘어진 얼룩이 된다",
          "items": {
            "type": "object",
            "allOf": [{ "$ref": "../common/defs.schema.json#/$defs/capture_time" }],
            "required": ["camera_id", "frame_uri"],
            "properties": {
              "camera_id": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
              "frame_uri": { "$ref": "../common/defs.schema.json#/$defs/object_uri" },
              "estimated_capture_time_ms": true,
              "timestamp_source": true,
              "timestamp_uncertainty_ms": true
            },
            "additionalProperties": false
          }
        },
        "scene_version": { "$ref": "../common/defs.schema.json#/$defs/version_id", "description": "정적 3D 가 있으면 그 Scene. 워커가 정적 3D 층을 쓰지 않으면 결과 scene_version 은 null 이다" }
      }
    },
    "result": {
      "type": "object",
      "description": "BEV 이미지 주소와 World 대응(픽셀 ↔ 미터). 전체 생성 메타데이터(합성 설정·프레임 기록 등, 계약 밖 형식 simai.bev_floorplan)는 metadata_uri 의 JSON 사본에 있다",
      "required": [
        "image_uri", "image_sha256", "content_type", "metadata_uri", "calibration_version", "scene_version", "created_at",
        "purpose", "safety_use", "coordinate_frame", "raster", "cameras_used", "cameras_skipped", "coverage_ratio",
        "room_outline", "input_provenance"
      ],
      "properties": {
        "image_uri": { "$ref": "../common/defs.schema.json#/$defs/object_uri", "description": "PNG. 알파 = 카메라가 바닥을 본 픽셀" },
        "image_sha256": { "$ref": "../common/defs.schema.json#/$defs/sha256" },
        "content_type": { "const": "image/png" },
        "metadata_uri": { "$ref": "../common/defs.schema.json#/$defs/object_uri", "description": "생성 메타데이터 JSON 사본" },
        "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id", "description": "실제로 쓴 보정 버전(입력과 같다). 보정 버전이 바뀌면 재생성 대상이다" },
        "scene_version": {
          "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/version_id" }, { "type": "null" }],
          "description": "정적 3D 층으로 빈 곳을 채웠을 때만 그 Scene 버전. 층을 쓰지 않았으면(입력에 scene_version 이 있어도) null"
        },
        "created_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
        "purpose": { "const": "OVERVIEW_DISPLAY_ONLY" },
        "safety_use": { "const": false },
        "coordinate_frame": {
          "type": "object",
          "required": ["frame", "unit", "handedness", "up_axis"],
          "properties": {
            "frame": { "const": "WORLD" },
            "unit": { "const": "m" },
            "handedness": { "const": "right" },
            "up_axis": { "const": "+Z" }
          },
          "additionalProperties": false
        },
        "raster": {
          "type": "object",
          "description": "BEV 격자와 World 대응. 열 = +X, 행 = −Y. 픽셀 (col, row) 중심의 World 좌표는 pixel_to_world · (col, row, 1) 이다(정수가 픽셀 중심). 바닥 평면 Z = 0",
          "required": ["width", "height", "meters_per_pixel", "origin_xy", "origin", "col_axis", "row_axis", "pixel_to_world", "world_bounds"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "meters_per_pixel": { "type": "number", "exclusiveMinimum": 0 },
            "origin_xy": { "$ref": "../common/defs.schema.json#/$defs/vec2", "description": "왼쪽 위 픽셀의 바깥 모서리 World (x, y), 미터" },
            "origin": { "const": "TOP_LEFT_PIXEL_OUTER_CORNER" },
            "col_axis": { "const": "+X" },
            "row_axis": { "const": "-Y" },
            "pixel_to_world": { "$ref": "../common/defs.schema.json#/$defs/mat3" },
            "world_bounds": {
              "type": "object",
              "required": ["min_xy", "max_xy"],
              "properties": {
                "min_xy": { "$ref": "../common/defs.schema.json#/$defs/vec2" },
                "max_xy": { "$ref": "../common/defs.schema.json#/$defs/vec2" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "cameras_used": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../common/defs.schema.json#/$defs/camera_id" }
        },
        "cameras_skipped": {
          "type": "object",
          "description": "프레임은 받았지만 쓰지 않은 카메라 → 이유(예: CAMERA_NOT_ABOVE_FLOOR)",
          "propertyNames": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1, "description": "카메라가 바닥을 본 픽셀 비율" },
        "room_outline": {
          "description": "대략 방 외곽(관리자 확인용, 정확도 주장 없음, 늘 inferred). 카메라가 본 바닥 픽셀의 볼록 껍질이라 오목한 방은 넓게 나온다. 외곽을 추출하지 않았으면 null",
          "oneOf": [
            {
              "type": "object",
              "required": ["source", "basis", "method", "accuracy", "polygon_xy", "openings"],
              "properties": {
                "source": { "const": "inferred" },
                "basis": { "enum": ["FLOOR_MASK", "CAMERA_FOOTPRINT"], "description": "FLOOR_MASK = 카메라별 바닥 마스크, CAMERA_FOOTPRINT = 카메라 시야 전체(벽도 바닥으로 펴져 시야 범위에 가깝다)" },
                "method": { "const": "CONVEX_HULL_OF_COVERAGE" },
                "accuracy": { "const": "NOT_CLAIMED" },
                "polygon_xy": {
                  "type": "array",
                  "minItems": 3,
                  "items": { "$ref": "../common/defs.schema.json#/$defs/vec2" },
                  "description": "World (x, y) 미터, 반시계, 시작점을 반복하지 않는다"
                },
                "openings": { "type": "null", "description": "문·개구부는 추출하지 않는다(모름)" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "input_provenance": { "$ref": "../common/defs.schema.json#/$defs/input_provenance" }
      },
      "additionalProperties": false
    }
  }
}
