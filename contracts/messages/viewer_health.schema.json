{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/viewer_health.schema.json",
  "title": "I2 viewer_health",
  "description": "EC2 → 뷰어, STOMP /topic/health (명세 12.2, 12.4, 6.2, 13장). EC2 가 Tier 0 health(I1), 노트북 하트비트, 구성 묶음 적용(config_ack), COMMITTED Scene 을 모아 1초마다(바뀌면 즉시) 보내는 화면용 상태다. Tier 0 health 원문은 tier0_health 에 그대로 싣는다(없으면 null). EC2 가 Tier 0 나 노트북 하트비트를 잃으면 system_health 는 UNSAFE_UNKNOWN 이다(3.2 이중 감시). Scene 불일치는 Tier 0 가 판정에 쓰는 scene_version(world_state)과 EC2 의 COMMITTED Scene 버전이 다를 때다(FR-12). 1.2.0: watches 선택 추가(워치 연결 상태, 확장 부록 C.6, S15P31A101-336). 1.1.0: scene.compatibility 선택 추가(S15P31A101-381). 1.0.0 신설(S15P31A101-206).",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "properties": {
    "msg_type": { "const": "viewer_health" },
    "payload": {
      "type": "object",
      "required": ["as_of", "system_health", "remote_state", "tier0_link", "laptop", "data_age_ms", "calibration_state", "config", "scene", "tier0_health"],
      "properties": {
        "as_of": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms", "description": "EC2 가 이 상태를 만든 시각" },
        "system_health": { "$ref": "../common/defs.schema.json#/$defs/system_health" },
        "remote_state": {
          "enum": ["NORMAL", "REMOTE_LINK_LOST", "CONTROL_HALTED"],
          "description": "NORMAL: Tier 0·노트북 모두 정상. REMOTE_LINK_LOST: Tier 0 하트비트는 끊겼지만 노트북이 Tier 0 정상을 알림(원격 전달 단절, 현장 경보 동작 중). CONTROL_HALTED: 노트북도 Tier 0 끊김·관제 정지를 알리거나, 노트북 하트비트가 없거나, Tier 0 처리가 멈춤(연결은 살아 있어도 t_latest_global 이 늘지 않음, 이때 tier0_link 는 CONNECTED 일 수 있다) (3.2, FR-11)"
        },
        "tier0_link": { "$ref": "../common/defs.schema.json#/$defs/link_state", "description": "EC2 ↔ Tier 0 I1 연결" },
        "laptop": {
          "type": "object",
          "required": ["link", "last_heartbeat_at"],
          "properties": {
            "link": { "$ref": "../common/defs.schema.json#/$defs/link_state", "description": "laptop_heartbeat 3회 누락이면 DISCONNECTED (3.10)" },
            "last_heartbeat_at": { "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" }, { "type": "null" }] }
          },
          "additionalProperties": false
        },
        "data_age_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }], "description": "as_of − 마지막 world_state 의 t_latest_global(EC2 가 아는 시계 차이 보정 후). 받은 적 없거나 모르면 null" },
        "calibration_state": { "$ref": "../common/defs.schema.json#/$defs/calibration_state" },
        "config": {
          "type": "object",
          "required": ["published_version", "applied_version", "sync"],
          "properties": {
            "published_version": { "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/version_id" }, { "type": "null" }], "description": "EC2 가 마지막으로 발행한 구성 묶음" },
            "applied_version": { "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/version_id" }, { "type": "null" }], "description": "Tier 0 config_ack 로 적용 확인된 버전" },
            "sync": { "$ref": "../common/defs.schema.json#/$defs/config_sync" }
          },
          "additionalProperties": false
        },
        "scene": {
          "type": "object",
          "required": ["committed_version", "live_version", "mismatch"],
          "properties": {
            "committed_version": { "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/version_id" }, { "type": "null" }], "description": "EC2 의 COMMITTED Scene(GET /api/scenes/current)" },
            "live_version": { "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/version_id" }, { "type": "null" }], "description": "마지막 world_state.scene_version" },
            "compatibility": { "$ref": "../common/scene_compatibility.schema.json" },
            "mismatch": { "type": "boolean", "description": "두 값이 모두 있고 다르면 true (FR-12 경고)" }
          },
          "additionalProperties": false
        },
        "tier0_health": { "oneOf": [{ "type": "object" }, { "type": "null" }], "description": "마지막으로 받은 I1 health 의 payload 그대로(health.schema.json). 받은 적 없으면 null" },
        "watches": {
          "type": "object",
          "description": "확장(부록 C.6): 등록된 워치(device.kind WATCH, 폐기 안 됨)의 I4 연결 상태. 워치는 개인 보조 채널이라 system_health·remote_state 에 넣지 않는다. 없으면 워치 확장을 쓰지 않는 EC2 다",
          "required": ["registered", "connected", "items"],
          "properties": {
            "registered": { "type": "integer", "minimum": 0, "description": "등록된 워치 수" },
            "connected": { "type": "integer", "minimum": 0, "description": "items 중 link 가 CONNECTED 인 수(활성 워치 수)" },
            "items": {
              "type": "array",
              "description": "device_id 오름차순",
              "items": {
                "type": "object",
                "required": ["device_id", "link", "last_heartbeat_at", "battery_pct", "transport"],
                "properties": {
                  "device_id": { "$ref": "../common/defs.schema.json#/$defs/instance_id" },
                  "link": {
                    "enum": ["CONNECTED", "LOST"],
                    "description": "CONNECTED: I4 연결이 열려 있고 마지막 watch_heartbeat(연결 직후는 연결 시각)가 EC2 가 준 interval_ms × 3 안. LOST: 그 밖(끊김·한 번도 안 붙음, C.6 LOST)"
                  },
                  "last_heartbeat_at": { "oneOf": [{ "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" }, { "type": "null" }], "description": "EC2 가 이 워치의 watch_heartbeat 를 마지막으로 받은 EC2 시각. 받은 적 없으면 null" },
                  "battery_pct": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 100 }, { "type": "null" }], "description": "CONNECTED 일 때 마지막 하트비트의 watch.battery_pct, 그 밖 null" },
                  "transport": { "enum": ["WIFI", "PHONE_BLUETOOTH", "CELLULAR", "UNKNOWN", null], "description": "CONNECTED 일 때 마지막 하트비트의 watch.transport, 그 밖 null" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "description": "Tier 0 나 노트북 연결을 잃으면 UNSAFE_UNKNOWN (3.2 이중 감시)",
          "if": {
            "anyOf": [
              { "properties": { "tier0_link": { "const": "DISCONNECTED" } }, "required": ["tier0_link"] },
              { "properties": { "laptop": { "properties": { "link": { "const": "DISCONNECTED" } }, "required": ["link"] } }, "required": ["laptop"] }
            ]
          },
          "then": { "properties": { "system_health": { "const": "UNSAFE_UNKNOWN" }, "remote_state": { "not": { "const": "NORMAL" } } } }
        }
      ]
    }
  }
}
