{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/messages/codec_info.schema.json",
  "title": "I0 코덱 정보",
  "description": "노트북 → RunPod Tier 0, 카메라별 영상 연결. 연결 직후와 새 stream_epoch 마다 프레임보다 먼저 한 번 보낸다. 그 뒤 키프레임부터 전송한다. 코덱 정보와 키프레임이 모두 도착할 때까지 그 카메라는 관측 없음으로 처리한다 (명세 12.7). 영상 연결의 기록이라 공통 봉투를 쓰지 않는다.",
  "type": "object",
  "required": ["camera_id", "stream_epoch", "codec", "sps", "pps", "pts_timebase", "width", "height"],
  "properties": {
    "camera_id": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
    "stream_epoch": { "type": "integer", "minimum": 0, "description": "이 코덱 정보가 적용되는 스트림. 프레임 헤더의 stream_epoch 와 같아야 한다" },
    "codec": { "enum": ["H264"], "description": "C110 stream1 은 H.264 High (3.3)" },
    "profile": { "type": "string" },
    "sps": { "$ref": "#/$defs/base64", "description": "H.264 SPS (Annex B 시작 코드 없이)" },
    "pps": { "$ref": "#/$defs/base64", "description": "H.264 PPS (Annex B 시작 코드 없이)" },
    "pts_timebase": { "$ref": "frame_header.schema.json#/$defs/timebase" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "nominal_fps": { "type": "number", "exclusiveMinimum": 0, "description": "카메라 설정 fps (운영 25)" }
  },
  "additionalProperties": false,

  "$defs": {
    "base64": { "type": "string", "minLength": 4, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  }
}
