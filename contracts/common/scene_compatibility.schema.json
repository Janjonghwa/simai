{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/common/scene_compatibility.schema.json",
  "title": "Scene–보정 정합 결과",
  "type": "object",
  "required": [
    "scene_version",
    "calibration_version",
    "verification",
    "regeneration_required",
    "reason",
    "max_center_delta_m",
    "max_rotation_delta_rad"
  ],
  "properties": {
    "scene_version": {
      "$ref": "defs.schema.json#/$defs/version_id"
    },
    "calibration_version": {
      "oneOf": [
        {
          "$ref": "defs.schema.json#/$defs/version_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "enum": [
        "VERIFIED",
        "DIMMED",
        "MISMATCH"
      ]
    },
    "regeneration_required": {
      "type": "boolean"
    },
    "reason": {
      "enum": [
        "SAME_CALIBRATION",
        "SMALL_CHANGE",
        "LARGE_CHANGE",
        "DIFFERENT_WORLD",
        "UNKNOWN"
      ]
    },
    "max_center_delta_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "max_rotation_delta_rad": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 3.141592653589793
    },
    "cameras": {
      "description": "선택(v7.28.0, S15P31A101-602). 카메라별 중심 이동·회전 변화(생성 보정 대비). EC2 GET /api/scenes/current 의 compatibility 만 싣고 viewer_health 에는 싣지 않는다. 두 보정의 카메라 자세를 실제로 비교했을 때만 배열(카메라 ID 순, max_* 는 이 값들의 최대)이고, 같은 보정(SAME_CALIBRATION, 모두 0)·다른 World·자세 미상이면 null 이다.",
      "type": [
        "array",
        "null"
      ],
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/camera_delta"
      }
    }
  },
  "$defs": {
    "camera_delta": {
      "type": "object",
      "required": [
        "camera_id",
        "center_delta_m",
        "rotation_delta_rad"
      ],
      "properties": {
        "camera_id": {
          "$ref": "defs.schema.json#/$defs/camera_id"
        },
        "center_delta_m": {
          "description": "카메라 중심 C = -R^T t 사이 거리, 미터",
          "type": "number",
          "minimum": 0
        },
        "rotation_delta_rad": {
          "description": "두 회전 사이 각도 acos((tr(R_a R_b^T) - 1) / 2), 라디안",
          "type": "number",
          "minimum": 0,
          "maximum": 3.141592653589793
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
