{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/common/defs.schema.json",
  "title": "simai 공통 정의",
  "description": "모든 계약이 공유하는 타입. World는 미터, 오른손, +Z 상방, 바닥 Z=0. 시각은 UTC int64 ms. 각도는 라디안. (명세 4.1, 4.2, 12.1)",
  "$defs": {
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch 밀리초"
    },
    "duration_ms": { "type": "number", "minimum": 0 },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "uri": {
      "type": "string",
      "minLength": 1,
      "description": "객체 저장소 주소(s3://...) 또는 Network Volume 경로(volume://<datacenter>/<path>). 영상·가중치·대형 산출물은 저장소에 넣지 않는다."
    },
    "object_uri": {
      "type": "string",
      "pattern": "^s3://[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]/\\S+$",
      "maxLength": 1093,
      "description": "객체 저장소(S3 또는 S3 호환 Lightsail 버킷)의 객체 주소 s3://<bucket>/<key> (명세 3.1, 12장 머리말). 이미지·클립은 메시지에 넣지 않고 이 주소로만 주고받는다. data: URI·Base64 본문·임시 서명 HTTPS 주소는 받지 않는다. 길이 한도는 s3:// + 버킷 63자 + / + 키 1024바이트"
    },

    "camera_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "world_id": { "type": "string", "minLength": 1, "description": "세션 단위 익명 World ID (예: w-0012)" },
    "version_id": { "type": "string", "minLength": 1, "description": "calibration_version, scene_version, config_version 등 (예: cal-7)" },

    "vec2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "world_xyz": { "$ref": "#/$defs/vec3", "description": "World 좌표 [x, y, z], 미터, Z-up" },
    "mat3": {
      "type": "array",
      "items": { "$ref": "#/$defs/vec3" },
      "minItems": 3,
      "maxItems": 3,
      "description": "행 우선 3x3 행렬"
    },
    "bbox_xyxy": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "픽셀 [x1, y1, x2, y2], 원본 해상도 기준"
    },
    "keypoint_2d": {
      "oneOf": [
        { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "[u, v, confidence]" },
        { "type": "null", "description": "검출되지 않음" }
      ]
    },

    "validity": { "enum": ["VALID", "UNCERTAIN", "UNAVAILABLE"] },
    "observation_state": { "enum": ["OBSERVED", "PREDICTED", "UNKNOWN"], "description": "명세 6.1" },
    "track_lifecycle": { "enum": ["TENTATIVE", "CONFIRMED", "OCCLUDED", "LOST"], "description": "명세 5.2. 관측 상태와 별도" },
    "identity_confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "IDENTITY_UNCERTAIN"] },
    "calibration_state": { "enum": ["UNCALIBRATED", "PROVISIONAL", "CALIBRATED", "DRIFTED"], "description": "명세 4.4" },
    "scene_state": { "enum": ["CANDIDATE", "VALIDATING", "COMMITTED", "REJECTED"], "description": "명세 6.2" },
    "timestamp_source": { "enum": ["CAMERA_STREAM", "RECEIVE_ESTIMATED", "FILE", "SIM"], "description": "명세 3.9" },
    "joint_source": { "enum": ["observed", "inferred"], "description": "observed=Tier 0 삼각측량, inferred=Tier 1 HMR" },
    "surface_source": {
      "enum": ["OBSERVED", "INTERPOLATED", "UNOBSERVED"],
      "description": "메시 표면·텍스처의 출처. OBSERVED는 실제 관측 픽셀, INTERPOLATED는 주변 관측으로 보간, UNOBSERVED는 관측 없음(기본 재질)"
    },
    "joint_layout": {
      "enum": ["COCO17", "HALPE26", "MHR70", "MHR_NATIVE"],
      "description": "COCO17 순서: nose, l_eye, r_eye, l_ear, r_ear, l_shoulder, r_shoulder, l_elbow, r_elbow, l_wrist, r_wrist, l_hip, r_hip, l_knee, r_knee, l_ankle, r_ankle"
    },

    "frame_source": { "enum": ["LIVE", "FILE", "SIM", "DATASET"], "description": "FrameSource 출처 (명세 20.4)" },
    "calibration_source": { "enum": ["G1_AUTO", "DATASET_GT", "SIM", "MODEL_ESTIMATE"], "description": "CalibrationProvider 출처 (명세 20.4). G1_AUTO = 무마커 자동 보정(4.3), MODEL_ESTIMATE = 이전 Run에서 모델(MapAnything 등)이 추정한 카메라를 입력으로 다시 쓴 경우. 2.0.0 의미 변경(메이저): v1.3 에서 쓰지 않는 마커 보정·평면도 대응점 출처 값을 뺐다(명세 4.3 대체 경로, 16장)" },
    "track_source": { "enum": ["TIER0_LOG", "TIER0_LIVE", "DATASET_GT", "SIM"], "description": "WorldTrackProvider 출처 (명세 20.4)" },

    "coordinate_frame": {
      "type": "object",
      "description": "결과물의 좌표계 선언. World 외의 좌표계는 쓰지 않는다. Three.js 변환은 뷰어 어댑터에서만 한다.",
      "required": ["frame", "unit", "handedness", "up_axis"],
      "properties": {
        "frame": { "const": "WORLD" },
        "unit": { "const": "m" },
        "handedness": { "const": "right" },
        "up_axis": { "const": "+Z" },
        "site_id": { "type": "string" }
      },
      "additionalProperties": false
    },

    "input_provenance": {
      "type": "object",
      "description": "결과물을 만든 입력의 출처 (명세 20.4 입력 대체 계약 규칙 2·3)",
      "required": ["frames", "is_upper_bound"],
      "properties": {
        "frames": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "$ref": "#/$defs/frame_source" },
            "dataset_id": { "type": "string", "description": "예: cmu_panoptic/160422_ultimatum1, scenario/2026-10-20_a" },
            "dataset_hash": { "$ref": "#/$defs/sha256" },
            "camera_ids": { "type": "array", "items": { "$ref": "#/$defs/camera_id" } }
          },
          "additionalProperties": false
        },
        "calibration": {
          "type": "object",
          "description": "보정 입력. 이미지만 넣어 모델이 카메라를 스스로 추정하는 Run에는 생략한다",
          "required": ["source", "calibration_version"],
          "properties": {
            "source": { "$ref": "#/$defs/calibration_source" },
            "calibration_version": { "$ref": "#/$defs/version_id" }
          },
          "additionalProperties": false
        },
        "tracks": {
          "type": "object",
          "description": "사람 관련 결과물에서 필수",
          "required": ["source", "provider_version"],
          "properties": {
            "source": { "$ref": "#/$defs/track_source" },
            "provider_version": { "type": "string" }
          },
          "additionalProperties": false
        },
        "is_upper_bound": {
          "type": "boolean",
          "description": "입력 중 하나라도 DATASET_GT 또는 SIM이면 true. true인 결과의 지표는 '입력이 완벽할 때의 상한'이며 제품 성능으로 주장하지 않는다."
        }
      },
      "additionalProperties": false
    },

    "reproducibility": {
      "type": "object",
      "description": "재현과 감사 추적 메타데이터 (명세 20.4, 20.5)",
      "required": ["run_id", "model_version", "input_hash"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "weights_hash": { "$ref": "#/$defs/sha256" },
        "input_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },

    "percentiles_ms": {
      "type": "object",
      "required": ["p50", "p95"],
      "properties": {
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7 (시간 순서, 재시작·여러 현장에서도 충돌 없음). event_id 에 쓴다 (명세 3.2 식별자 규칙)"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "송신 주체 식별자 (tier0-01, laptop-01, ec2). Tier 0 인스턴스 식별자가 이벤트의 gateway_id 다 (명세 12.1)"
    },

    "risk_origin": {
      "enum": ["LIVE", "PLANNED", "REPLAY", "WHAT_IF"],
      "description": "판정 출처 (명세 7.1). 실제 알림 채널로 가는 것은 LIVE 뿐이다 (7.4, 11.4)"
    },
    "severity": {
      "enum": ["CRITICAL", "HIGH", "CAUTION", "INFO"],
      "description": "위험 정도 (명세 7.1). 신뢰도가 낮아도 내려가지 않는다 (7.3)"
    },
    "risk_confidence": {
      "enum": ["HIGH", "LOW"],
      "description": "증거 신뢰도 (명세 7.3). severity 와 독립이다"
    },
    "confidence_reason": {
      "enum": ["Z_UNKNOWN", "PREDICTED", "PROVISIONAL_CALIB", "SINGLE_VIEW", "JOINT_UNCERTAIN", "IDENTITY_UNCERTAIN", "UNSPECIFIED"],
      "description": "'확인 필요'의 이유 (명세 7.1). Z_UNKNOWN: 지지 표면·높이 모름(z_validity UNAVAILABLE). PREDICTED: 위치가 관측이 아니라 예측·마지막 추정값(관측 상실 포함). PROVISIONAL_CALIB: 보정 PROVISIONAL. SINGLE_VIEW: 2대 이상 유효 관측 없음. JOINT_UNCERTAIN: 근거 관절 UNCERTAIN. IDENTITY_UNCERTAIN: 카메라 간 연결이 애매함. UNSPECIFIED: 확인 필요인데 생산자가 원인을 적지 않음(이유 목록 이전 형식의 needs_check=true 를 옮길 때만, 원인을 지어내지 않는다)"
    },
    "confidence_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/confidence_reason" },
      "uniqueItems": true,
      "description": "'확인 필요'의 이유 목록 (명세 7.1). 비어 있지 않으면 '확인 필요'다. 여러 개가 함께 붙을 수 있다"
    },
    "needs_check_matches_reasons": {
      "description": "confidence_reasons 가 있으면 needs_check 는 '이유가 비어 있지 않음'과 같다 (명세 7.1 '확인 필요'의 정의). confidence_reasons 가 없는 메시지(이전 버전 송신 측)는 needs_check 만으로 읽는다",
      "allOf": [
        {
          "if": { "properties": { "confidence_reasons": { "minItems": 1 } }, "required": ["confidence_reasons"] },
          "then": { "properties": { "needs_check": { "const": true } } }
        },
        {
          "if": { "properties": { "confidence_reasons": { "maxItems": 0 } }, "required": ["confidence_reasons"] },
          "then": { "properties": { "needs_check": { "const": false } } }
        }
      ]
    },
    "risk_lifecycle": { "enum": ["RAISED", "UPDATED", "RESOLVED"], "description": "명세 6.2, 6.4" },
    "risk_verification": {
      "enum": ["VERIFIED", "UNVERIFIABLE"],
      "description": "해소 여부를 관측으로 확인할 수 있는지 (명세 6.2, 6.4). UNVERIFIABLE 이면 자동 해소하지 않는다"
    },
    "system_health": { "enum": ["NOMINAL", "DEGRADED", "UNSAFE_UNKNOWN"], "description": "명세 6.2" },
    "config_sync": {
      "enum": ["CURRENT", "PENDING", "UNVERIFIED", "STALE"],
      "description": "명세 6.2, 3.2. 어느 상태든 판정은 계속한다"
    },
    "link_state": { "enum": ["CONNECTED", "DISCONNECTED"] },

    "rule_metrics": {
      "type": "object",
      "description": "규칙의 수치 근거. 단위는 키 이름에 붙인다 (예: edge_distance_m, height_diff_m)",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "number" }
    },

    "severity_upward_only": {
      "description": "같은 객체의 proposed_severity 는 severity 보다 높은 등급이거나 null 이다. VLM 은 상향 의견만 내고 경보를 낮추거나 끄지 못한다 (명세 5.4, 원칙 6, AGENTS.md 규칙 4). 같은 등급도 의견이 아니므로 null 로 둔다",
      "allOf": [
        {
          "if": { "properties": { "severity": { "const": "CRITICAL" } }, "required": ["severity"] },
          "then": { "properties": { "proposed_severity": { "type": "null" } } }
        },
        {
          "if": { "properties": { "severity": { "const": "HIGH" } }, "required": ["severity"] },
          "then": { "properties": { "proposed_severity": { "enum": [null, "CRITICAL"] } } }
        },
        {
          "if": { "properties": { "severity": { "const": "CAUTION" } }, "required": ["severity"] },
          "then": { "properties": { "proposed_severity": { "enum": [null, "CRITICAL", "HIGH"] } } }
        },
        {
          "if": { "properties": { "severity": { "const": "INFO" } }, "required": ["severity"] },
          "then": { "properties": { "proposed_severity": { "enum": [null, "CRITICAL", "HIGH", "CAUTION"] } } }
        }
      ]
    },

    "ack_channel": {
      "enum": ["CONTROL_ROOM", "FOREMAN_PWA", "SITE_BUTTON"],
      "description": "운영자 확인이 들어온 곳: 관제 화면, 반장 PWA, 노트북 현장 확인 버튼 (명세 3.2, 3.10)"
    },
    "operator_ack": {
      "type": "object",
      "description": "운영자 확인(ACKNOWLEDGED) 한 건. 확인은 해소가 아니다 (명세 6.4). 누가 확인해도 노트북 반복 소리를 멈추고, 점멸 표시는 해소까지 유지한다. 누가 확인했는지는 저널에 남긴다 (3.2)",
      "required": ["ack_id", "channel", "actor_role", "actor_id", "acked_at"],
      "properties": {
        "ack_id": { "$ref": "#/$defs/uuid", "description": "확인을 만든 쪽(EC2 또는 노트북)이 발급. 중복 수신 제거용" },
        "channel": { "$ref": "#/$defs/ack_channel" },
        "actor_role": { "enum": ["ADMIN", "FOREMAN", "SITE"], "description": "SITE 는 현장 확인 버튼(노트북)" },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "description": "계정 ID 또는 노트북 기기 ID. 사람 이름을 넣지 않는다 (명세 11.4-5)"
        },
        "acked_at": { "$ref": "#/$defs/timestamp_ms" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "현장 확인 버튼은 노트북 기기만, 관제 화면·PWA 는 계정(관리자·반장)만",
          "if": { "properties": { "channel": { "const": "SITE_BUTTON" } }, "required": ["channel"] },
          "then": { "properties": { "actor_role": { "const": "SITE" } } },
          "else": { "properties": { "actor_role": { "enum": ["ADMIN", "FOREMAN"] } } }
        }
      ]
    },

    "frame_key": {
      "type": "object",
      "description": "프레임의 유일 식별자 (camera_id, stream_epoch, frame_sequence) (명세 12.7)",
      "required": ["camera_id", "stream_epoch", "frame_sequence"],
      "properties": {
        "camera_id": { "$ref": "#/$defs/camera_id" },
        "stream_epoch": { "type": "integer", "minimum": 0, "description": "카메라 스트림이 재연결될 때마다 증가" },
        "frame_sequence": { "type": "integer", "minimum": 0, "description": "같은 stream_epoch 안에서 단조 증가. 빈 구간은 gateway_to_runpod_loss" }
      }
    },
    "capture_time": {
      "type": "object",
      "description": "촬영 시각 계약 (명세 3.9). 모든 프레임·관측에 붙인다. C110 기본값은 RECEIVE_ESTIMATED",
      "required": ["estimated_capture_time_ms", "timestamp_source", "timestamp_uncertainty_ms"],
      "properties": {
        "estimated_capture_time_ms": { "$ref": "#/$defs/timestamp_ms" },
        "timestamp_source": { "$ref": "#/$defs/timestamp_source" },
        "timestamp_uncertainty_ms": {
          "$ref": "#/$defs/duration_ms",
          "description": "기준(초기값 25ms)을 넘는 카메라는 그 시각의 삼각측량에서 뺀다"
        }
      }
    }
  }
}
