{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/providers/calibration.schema.json",
  "title": "CalibrationProvider 출력",
  "description": "보정 한 버전 (명세 4장, 20.4 입력 대체 계약). G1 자동 보정과 대체 구현(DATASET_GT, SIM, MODEL_ESTIMATE)이 같은 형식을 낸다. 2.0.0 의미 변경(메이저): v1.3 에서 쓰지 않는 마커 보정·평면도 대응점 출처 값(common/defs calibration_source)과 마커·실측 평면도 스케일 근거 값(scale_basis)을 뺐다. 2.1.0(필드 추가, S15P31A101-277): World 축 출처 `world_axes_source`(선택), scale_basis 값 `MEASURED_CAMERA_HEIGHT`. 2.2.0(필드 추가, S15P31A101-467): 세팅 출처 `setup_session_id`·계보 `previous_calibration_version`(선택, content_hash 제외). 2.3.0(필드 추가, S15P31A101-462): 스케일 결정 출처 `scale_source`·카메라 높이+실측 정물 공동 스케일 추정 및 잔차 기록 `scale_estimation`(선택). 2.4.0(필드 추가, S15P31A101-542): 바닥 법선과 카메라별 실측 높이를 결합한 World +Z 피치·롤 기울기 보정 기록 `floor_tilt_correction`(선택). 2.5.0(필드 추가, S15P31A101-584): 같은 현장 재보정을 이전 채택 보정의 World 에 다시 맞춘 기록 `world_anchor`(선택).",
  "type": "object",
  "required": [
    "schema_version", "calibration_version", "provider_source", "state",
    "created_at", "coordinate_frame", "scale_basis", "extrinsic_convention", "cameras"
  ],
  "properties": {
    "schema_version": { "$ref": "../common/defs.schema.json#/$defs/semver" },
    "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
    "provider_source": { "$ref": "../common/defs.schema.json#/$defs/calibration_source" },
    "provider_version": { "type": "string" },
    "state": { "$ref": "../common/defs.schema.json#/$defs/calibration_state" },
    "created_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
    "coordinate_frame": { "$ref": "../common/defs.schema.json#/$defs/coordinate_frame" },
    "scale_basis": { "$ref": "#/$defs/scale_basis", "description": "스케일을 정한 주 근거" },
    "scale_source": {
      "$ref": "#/$defs/scale_source",
      "description": "2.3.0(선택, S15P31A101-462): 보정에 최종 적용된 스케일 결정 출처(HEIGHT_ONLY 카메라 높이 단독 · JOINT 카메라 높이+실측 정물 공동 최소제곱 · PROP_ONLY 실측 정물 단독 · MODEL_ESTIMATE 모델 자체 추정). 생략은 기록 없음이다"
    },
    "scale_estimation": {
      "$ref": "#/$defs/scale_estimation",
      "description": "2.3.0(선택, S15P31A101-462): 카메라 높이 실측과 현장 안전 소품(라바콘·개구부 안내판) 공동 스케일 추정 결과, 근거별 배율((a) 높이 단독, (b) 정물 단독, (c) 공동 추정), 바닥 높이 오프셋, 불일치 경고 및 잔차 기록"
    },
    "floor_tilt_correction": {
      "$ref": "#/$defs/floor_tilt_correction",
      "description": "2.4.0(선택, S15P31A101-542): 바닥 RANSAC 법선과 카메라별 실측 높이를 함께 써서 World +Z 피치·롤 기울기를 바로잡은 보정량(rad)·근거(쓴 카메라·보정 전후 잔차)·관측/추정 구분 및 거부 사유 기록"
    },
    "world_anchor": {
      "$ref": "#/$defs/world_anchor",
      "description": "2.5.0(선택, S15P31A101-584): 카메라가 움직이지 않은 재보정이면 새 World 를 이전 채택 보정(reference_calibration_version)의 World 로 옮겨(Z 축 회전 + 수평 이동, 바닥 Z=0·+Z·축척은 이 보정 그대로) 기존 구역·배치가 그대로 맞게 한다. accepted=true 면 cameras 의 R·t 가 이미 이전 World 기준이다. false 면 이 보정의 World 를 그대로 두고 사유를 남긴다. 생략은 비교할 이전 보정이 없었다는 뜻이다"
    },
    "world_axes_source": {
      "enum": ["WALLS", "WALL_AND_FLOOR", "MANUAL_FLOOR_POINTS", "CAMERA_LAYOUT"],
      "description": "World 원점·X·Y 축을 정한 근거 (명세 4.1, 4.3 2단계, 2.1.0). 우선순위 MANUAL_FLOOR_POINTS > WALLS > WALL_AND_FLOOR. WALLS = 서로 수직인 경계 벽 두 묶음과 바닥의 모서리(자동), WALL_AND_FLOOR = 경계 벽이 한 방향뿐인 열린 공간에서 지지 점이 가장 많은 경계 벽의 안쪽 법선을 X 로, 원점은 그 벽·바닥 교선 위 카메라 중심 평균의 수선 발(자동, 원점은 카메라 배치에 따름), MANUAL_FLOOR_POINTS = 설치자가 카메라 그림에서 찍은 바닥 두 점(원점, +X 방향 점, 선택 입력, 주면 벽보다 우선), CAMERA_LAYOUT = 카메라 배치 기준(예약, 아직 내지 않음). Z 는 언제나 바닥 법선(상방)이다. 2.0.0 문서와 대체 구현(DATASET_GT·SIM)은 생략할 수 있고, 생략은 '기록 없음'이지 WALLS 가 아니다"
    },
    "scale_cross_check_basis": {
      "type": "array",
      "items": { "$ref": "#/$defs/scale_basis" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "주 근거(scale_basis)와 교차 확인해 일치한 다른 근거, 우선순위 순 (명세 4.3 둘 이상 교차 확인, 4.4). 교차 확인하지 않았으면 생략"
    },
    "extrinsic_convention": {
      "const": "OPENCV_WORLD_TO_CAMERA",
      "description": "x_cam = R · x_world + t. 카메라 좌표는 OpenCV 규약(x 오른쪽, y 아래, z 앞)"
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/camera_calibration" }
    },
    "validation": {
      "type": "object",
      "description": "독립 검증 결과 (명세 4.4 CALIBRATED 기준). 보정에 쓰지 않은 검증점 기준",
      "properties": {
        "checkpoint_count": { "type": "integer", "minimum": 0 },
        "max_position_error_m": {
          "type": "number",
          "minimum": 0,
          "description": "실측 기준점 대비 절대 위치 오차 최대값. 실측 기준점이 있을 때만(개발 교실 G1·G2). 수정 6 이후 현장 CALIBRATED 판정에는 max_pairwise_position_disagreement_m 를 쓴다"
        },
        "max_pairwise_position_disagreement_m": {
          "type": "number",
          "minimum": 0,
          "description": "검산점마다 카메라 쌍별로 구한 위치끼리의 불일치 최대값 (명세 4.4 수정 6, 표본이 적어 p95 가 아니라 최대값)"
        },
        "max_head_height_error_m": { "type": "number", "minimum": 0 },
        "floor_plane_disagreement_m": { "type": "number", "minimum": 0 },
        "floor_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "content_hash": { "$ref": "../common/defs.schema.json#/$defs/sha256" },
    "previous_calibration_version": {
      "$ref": "../common/defs.schema.json#/$defs/version_id",
      "description": "2.2.0(선택, S15P31A101-467): 이 보정을 만들 때 기준이 된 이전 활성 보정 버전(현장 세팅이 Tier 0 의 그때 활성 보정에서 출발). content_hash 에 넣지 않는 계보 정보다"
    },
    "setup_session_id": {
      "$ref": "../common/defs.schema.json#/$defs/uuid",
      "description": "2.2.0(선택, S15P31A101-467): 이 보정을 만든 현장 세팅 세션. 있으면 세팅 출처 보정이다(Tier 0 는 구성 묶음으로 받은 세팅 보정을 계보 확인 뒤 새 World 기준으로 채택). content_hash 에 넣지 않는다"
    }
  },
  "additionalProperties": false,

  "allOf": [
    {
      "description": "공개 데이터 정답·시뮬레이터·모델 추정 카메라는 우리 현장의 검증된 보정이 아니므로 CALIBRATED가 될 수 없다 (명세 20.4 규칙 4)",
      "if": {
        "properties": { "provider_source": { "enum": ["DATASET_GT", "SIM", "MODEL_ESTIMATE"] } },
        "required": ["provider_source"]
      },
      "then": { "properties": { "state": { "enum": ["UNCALIBRATED", "PROVISIONAL"] } } }
    },
    {
      "description": "CALIBRATED는 출처와 관계없이 독립 검증점 결과(검산점 수, 머리 높이 오차, 위치 불일치)가 있어야 한다 (명세 4.4). 이전 문서 호환을 위해 위치는 쌍별 불일치와 절대 위치 오차 중 하나만 있어도 스키마는 통과하고, 수정 6 기준(쌍별 불일치 필수, 출처 G1_AUTO)은 계약 시험에서 본다",
      "if": {
        "properties": { "state": { "const": "CALIBRATED" } },
        "required": ["state"]
      },
      "then": {
        "required": ["validation"],
        "properties": {
          "validation": {
            "required": ["checkpoint_count", "max_head_height_error_m"],
            "anyOf": [
              { "required": ["max_pairwise_position_disagreement_m"] },
              { "required": ["max_position_error_m"] }
            ]
          }
        }
      }
    }
  ],

  "$defs": {
    "scale_basis": {
      "type": "string",
      "enum": [
        "MEASURED_OBJECT", "MEASURED_CAMERA_HEIGHT", "KNOWN_PERSON_HEIGHT", "HUMAN_HEIGHT_STATS", "STANDARD_OBJECT",
        "MODEL_ESTIMATE", "DATASET_GT"
      ],
      "description": "스케일 근거 (명세 4.3 우선순위: 실측 정물 > 카메라 높이 실측 > 키를 아는 사람 > 사람 키 통계 > 표준 사물 크기 > 모델 자체 추정). MEASURED_OBJECT = 치수를 미리 잰 정물(안전봉·라바콘 등), MEASURED_CAMERA_HEIGHT = 줄자로 잰 바닥 → 렌즈 중심 높이와 보정 바닥 평면에서 잰 카메라 높이의 비(2대 이상, 카메라끼리 일치해야 씀, 2.1.0), KNOWN_PERSON_HEIGHT = 키를 미리 잰 사람의 보정 걷기, HUMAN_HEIGHT_STATS = 지나간 여러 사람의 키 통계, STANDARD_OBJECT = 문·책상 같은 표준 사물 크기, MODEL_ESTIMATE = 모델(MapAnything 등) 메트릭 추정, DATASET_GT = 공개 데이터 정답. 2.0.0 에서 마커 보드 값과 실측 평면도 값(수정 6 에서 제거)을 뺐다"
    },
    "scale_source": {
      "type": "string",
      "enum": [
        "HEIGHT_ONLY",
        "JOINT",
        "PROP_ONLY",
        "MODEL_ESTIMATE"
      ],
      "description": "보정에 최종 적용된 스케일 결정 방식 (2.3.0, S15P31A101-462). HEIGHT_ONLY = 줄자로 잰 카메라 높이 단독(정물 미검출 또는 불일치 경고 시 보수적 유지), JOINT = 카메라 높이 + 현장 안전 소품(라바콘·개구부 안내판) 단일 최소제곱 공동 추정, PROP_ONLY = 실측 정물 단독, MODEL_ESTIMATE = 모델 자체 추정"
    },
    "scale_prop_residual": {
      "type": "object",
      "required": [
        "kind",
        "dimension",
        "expected_m",
        "measured_m",
        "residual_cm"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "TRAFFIC_CONE",
            "OPENING_SIGN"
          ]
        },
        "dimension": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expected_m": {
          "type": "number",
          "minimum": 0
        },
        "measured_m": {
          "type": "number"
        },
        "residual_cm": {
          "type": "number"
        },
        "cameras": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "../common/defs.schema.json#/$defs/camera_id"
          }
        }
      },
      "additionalProperties": false
    },
    "scale_residuals": {
      "type": "object",
      "properties": {
        "camera_heights_cm": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scale_prop_residual"
          }
        }
      },
      "additionalProperties": false
    },
    "scale_estimation": {
      "type": "object",
      "required": [
        "scale_source",
        "applied_scale",
        "height_only_scale"
      ],
      "properties": {
        "scale_source": {
          "$ref": "#/$defs/scale_source"
        },
        "applied_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_only_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prop_only_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "joint_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "floor_offset_m": {
          "type": "number"
        },
        "disagreement_ratio": {
          "type": "number",
          "minimum": 0
        },
        "disagreement_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "disagreement_warning": {
          "type": "boolean"
        },
        "warning_message": {
          "type": "string",
          "maxLength": 500
        },
        "outliers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "residuals": {
          "$ref": "#/$defs/scale_residuals"
        }
      },
      "additionalProperties": false
    },
    "floor_tilt_correction": {
      "type": "object",
      "required": [
        "status",
        "applied",
        "pitch_rad",
        "roll_rad",
        "tilt_deg",
        "max_tilt_deg",
        "used_cameras",
        "observation_sources",
        "estimation_method",
        "residuals_before_cm",
        "residuals_after_cm",
        "rejection_reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "APPLIED",
            "INSUFFICIENT_CAMERAS",
            "REJECTED"
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "pitch_rad": {
          "type": ["number", "null"],
          "description": "World +X 축 둘레 회전 보정량(rad). 3대 미만이라 추정하지 못했을 때는 null(모르면 비운다)"
        },
        "roll_rad": {
          "type": ["number", "null"],
          "description": "World +Y 축 둘레 회전 보정량(rad). 3대 미만이라 추정하지 못했을 때는 null(모르면 비운다)"
        },
        "tilt_deg": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "바닥 RANSAC 법선에서 회전한 총 기울기 각도(deg). 3대 미만이라 추정하지 못했을 때는 null"
        },
        "max_tilt_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "허용 최대 기울기 보정 상한(deg, 기본 3.0). 이 값을 넘는 보정은 거부한다"
        },
        "used_cameras": {
          "type": "array",
          "items": {
            "$ref": "../common/defs.schema.json#/$defs/camera_id"
          },
          "uniqueItems": true
        },
        "missing_cameras": {
          "type": "array",
          "items": {
            "$ref": "../common/defs.schema.json#/$defs/camera_id"
          },
          "uniqueItems": true
        },
        "unknown_cameras": {
          "type": "array",
          "items": {
            "$ref": "../common/defs.schema.json#/$defs/camera_id"
          },
          "uniqueItems": true
        },
        "observation_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "POINTCLOUD_FLOOR_RANSAC",
              "MEASURED_CAMERA_HEIGHT"
            ]
          }
        },
        "estimation_method": {
          "type": "string",
          "enum": [
            "FLOOR_RANSAC_ONLY",
            "REGULARIZED_SMALL_ROTATION_LSQ"
          ]
        },
        "observed_heights_m": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "estimated_heights_before_m": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "estimated_heights_after_m": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "residuals_before_cm": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "residuals_after_cm": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "residual_rms_before_cm": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "residual_rms_after_cm": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "rejection_reason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "APPLIED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "applied": { "const": true },
              "pitch_rad": { "type": "number" },
              "roll_rad": { "type": "number" },
              "tilt_deg": { "type": "number" },
              "used_cameras": { "minItems": 3 },
              "rejection_reason": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["INSUFFICIENT_CAMERAS", "REJECTED"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "applied": { "const": false },
              "rejection_reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "world_anchor": {
      "type": "object",
      "required": ["accepted", "reason", "reference_calibration_version", "method", "limits"],
      "properties": {
        "accepted": { "type": "boolean", "description": "true = cameras 의 R·t 를 이전 World 로 옮겼다" },
        "reason": {
          "enum": [
            "ANCHORED", "DISABLED", "PREVIOUS_NOT_USABLE", "SITE_MISMATCH", "INSUFFICIENT_CAMERAS", "DEGENERATE_LAYOUT",
            "CENTER_RESIDUAL_EXCEEDED", "SCALE_OUT_OF_RANGE", "ORIENTATION_CHANGE_EXCEEDED"
          ],
          "description": "ANCHORED = 채택. DISABLED = 운영자가 워커 설정(SIMAI_SETUP_WORLD_ANCHOR=off)으로 껐다(추정하지 않음). PREVIOUS_NOT_USABLE = 이전 보정이 UNCALIBRATED 또는 정답·시뮬레이터 출처, SITE_MISMATCH = 현장 ID 다름, INSUFFICIENT_CAMERAS = 같은 ID 카메라 3대 미만(잔차로 검증 불가), DEGENERATE_LAYOUT = 카메라 수평 배치가 너무 좁아 회전을 정할 수 없음, CENTER_RESIDUAL_EXCEEDED·SCALE_OUT_OF_RANGE·ORIENTATION_CHANGE_EXCEEDED = 카메라가 움직였을 가능성(limits 초과)"
        },
        "reference_calibration_version": {
          "$ref": "../common/defs.schema.json#/$defs/version_id",
          "description": "비교한 이전 채택 보정(Tier 0 의 그때 활성 보정). accepted=true 면 이 보정의 World 를 그대로 쓴다"
        },
        "method": { "const": "CAMERA_CENTER_YAW_XY", "description": "같은 카메라 ID 의 중심을 바닥에 투영한 2D 맞춤(Kabsch yaw·이동, Umeyama 축척 진단)" },
        "limits": {
          "type": "object",
          "required": ["max_center_residual_m", "max_scale_deviation", "max_orientation_change_rad", "min_cameras"],
          "properties": {
            "max_center_residual_m": { "type": "number", "exclusiveMinimum": 0 },
            "max_scale_deviation": { "type": "number", "exclusiveMinimum": 0 },
            "max_orientation_change_rad": { "type": "number", "exclusiveMinimum": 0 },
            "min_cameras": { "type": "integer", "minimum": 3 }
          },
          "additionalProperties": false
        },
        "used_cameras": {
          "type": "array",
          "items": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
          "uniqueItems": true
        },
        "yaw_rad": { "type": ["number", "null"], "description": "새 World → 이전 World 의 +Z 둘레 회전(rad). 추정하지 못했으면 null" },
        "translation_m": {
          "type": ["array", "null"],
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "새 World → 이전 World 의 수평 이동 [x, y] (m, Z 이동 없음). 추정하지 못했으면 null"
        },
        "scale": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "description": "2D 닮음 맞춤의 축척(이전/새). 판정에만 쓰고 적용하지 않는다(축척 정본은 이 보정의 실측 높이)"
        },
        "max_center_residual_m": { "type": ["number", "null"], "minimum": 0 },
        "max_orientation_change_rad": { "type": ["number", "null"], "minimum": 0 },
        "center_residuals_m": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "additionalProperties": { "type": "number", "minimum": 0 },
          "description": "카메라별 배치 잔차(m): 축척까지 맞춘 2D 닮음 변환 뒤 남는 수평 중심 차이. 판정 기준"
        },
        "applied_center_residuals_m": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "additionalProperties": { "type": "number", "minimum": 0 },
          "description": "카메라별 적용 잔차(m): 실제 적용한 강체(축척 1) 변환 뒤 남는 수평 중심 차이. 기록용"
        },
        "vertical_differences_m": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "additionalProperties": { "type": "number" },
          "description": "카메라별 높이 차이(새 − 이전, m). 이전 바닥 기울기·실측 높이 차이를 보여 줄 뿐 판정에 쓰지 않는다"
        },
        "orientation_changes_rad": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "additionalProperties": { "type": "number", "minimum": 0 },
          "description": "카메라별 방향 변화(rad): 변환 뒤 새 R 과 이전 R 사이 각"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
          "then": {
            "required": ["used_cameras", "yaw_rad", "translation_m", "scale", "center_residuals_m"],
            "properties": {
              "reason": { "const": "ANCHORED" },
              "yaw_rad": { "type": "number" },
              "translation_m": { "type": "array" },
              "scale": { "type": "number" },
              "used_cameras": { "minItems": 3 }
            }
          },
          "else": { "properties": { "reason": { "not": { "const": "ANCHORED" } } } }
        }
      ],
      "additionalProperties": false
    },
    "camera_calibration": {
      "type": "object",
      "required": ["camera_id", "image_size", "K", "distortion", "R", "t"],
      "properties": {
        "camera_id": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
        "image_size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] 픽셀. 스트림 해상도가 바뀌면 이 보정은 DRIFTED"
        },
        "K": { "$ref": "../common/defs.schema.json#/$defs/mat3" },
        "distortion": {
          "type": "object",
          "required": ["model", "coeffs"],
          "properties": {
            "model": { "enum": ["OPENCV_PINHOLE", "OPENCV_FISHEYE", "NONE"] },
            "coeffs": {
              "type": "array",
              "items": { "type": "number" },
              "description": "OPENCV_PINHOLE: [k1, k2, p1, p2, k3, ...], OPENCV_FISHEYE: [k1, k2, k3, k4], NONE: []"
            }
          },
          "additionalProperties": false
        },
        "R": { "$ref": "../common/defs.schema.json#/$defs/mat3", "description": "World → 카메라 회전. 직교·det=+1은 계약 시험에서 검사" },
        "t": { "$ref": "../common/defs.schema.json#/$defs/vec3", "description": "World → 카메라 이동, 미터" },
        "camera_height_m": { "type": "number", "description": "바닥(Z=0)에서 카메라 중심까지 높이. 검산용" },
        "reprojection_error_px": {
          "type": "object",
          "properties": {
            "median": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
