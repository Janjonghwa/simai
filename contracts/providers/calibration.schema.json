{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/providers/calibration.schema.json",
  "title": "CalibrationProvider 출력",
  "description": "보정 한 버전 (명세 4장, 20.4 입력 대체 계약). G1 자동 보정과 대체 구현(CHARUCO, DATASET_GT, SIM, 연구용 MANUAL_PNP)이 같은 형식을 낸다.",
  "type": "object",
  "required": [
    "schema_version", "calibration_version", "provider_source", "state",
    "created_at", "coordinate_frame", "scale_basis", "extrinsic_convention", "cameras"
  ],
  "properties": {
    "schema_version": { "$ref": "../common/defs.schema.json#/$defs/semver" },
    "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
    "provider_source": { "$ref": "../common/defs.schema.json#/$defs/calibration_source" },
    "provider_version": { "type": "string" },
    "state": { "$ref": "../common/defs.schema.json#/$defs/calibration_state" },
    "created_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
    "coordinate_frame": { "$ref": "../common/defs.schema.json#/$defs/coordinate_frame" },
    "scale_basis": { "$ref": "#/$defs/scale_basis", "description": "스케일을 정한 주 근거" },
    "scale_cross_check_basis": {
      "type": "array",
      "items": { "$ref": "#/$defs/scale_basis" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "주 근거(scale_basis)와 교차 확인해 일치한 다른 근거, 우선순위 순 (명세 4.3 둘 이상 교차 확인, 4.4). 교차 확인하지 않았으면 생략"
    },
    "extrinsic_convention": {
      "const": "OPENCV_WORLD_TO_CAMERA",
      "description": "x_cam = R · x_world + t. 카메라 좌표는 OpenCV 규약(x 오른쪽, y 아래, z 앞)"
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/camera_calibration" }
    },
    "validation": {
      "type": "object",
      "description": "독립 검증 결과 (명세 4.4 CALIBRATED 기준). 보정에 쓰지 않은 검증점 기준",
      "properties": {
        "checkpoint_count": { "type": "integer", "minimum": 0 },
        "max_position_error_m": {
          "type": "number",
          "minimum": 0,
          "description": "실측 기준점 대비 절대 위치 오차 최대값. 실측 기준점이 있을 때만(개발 교실 G1·G2). 수정 6 이후 현장 CALIBRATED 판정에는 max_pairwise_position_disagreement_m 를 쓴다"
        },
        "max_pairwise_position_disagreement_m": {
          "type": "number",
          "minimum": 0,
          "description": "검산점마다 카메라 쌍별로 구한 위치끼리의 불일치 최대값 (명세 4.4 수정 6, 표본이 적어 p95 가 아니라 최대값)"
        },
        "max_head_height_error_m": { "type": "number", "minimum": 0 },
        "floor_plane_disagreement_m": { "type": "number", "minimum": 0 },
        "floor_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "content_hash": { "$ref": "../common/defs.schema.json#/$defs/sha256" }
  },
  "additionalProperties": false,

  "allOf": [
    {
      "description": "공개 데이터 정답·시뮬레이터·모델 추정 카메라는 우리 현장의 검증된 보정이 아니므로 CALIBRATED가 될 수 없다 (명세 20.4 규칙 4)",
      "if": {
        "properties": { "provider_source": { "enum": ["DATASET_GT", "SIM", "MODEL_ESTIMATE"] } },
        "required": ["provider_source"]
      },
      "then": { "properties": { "state": { "enum": ["UNCALIBRATED", "PROVISIONAL"] } } }
    },
    {
      "description": "CALIBRATED는 출처와 관계없이 독립 검증점 결과(검산점 수, 머리 높이 오차, 위치 불일치)가 있어야 한다 (명세 4.4). 이전 문서 호환을 위해 위치는 쌍별 불일치와 절대 위치 오차 중 하나만 있어도 스키마는 통과하고, 수정 6 기준(쌍별 불일치 필수, 출처 G1_AUTO·CHARUCO)은 계약 시험에서 본다",
      "if": {
        "properties": { "state": { "const": "CALIBRATED" } },
        "required": ["state"]
      },
      "then": {
        "required": ["validation"],
        "properties": {
          "validation": {
            "required": ["checkpoint_count", "max_head_height_error_m"],
            "anyOf": [
              { "required": ["max_pairwise_position_disagreement_m"] },
              { "required": ["max_position_error_m"] }
            ]
          }
        }
      }
    }
  ],

  "$defs": {
    "scale_basis": {
      "enum": [
        "FLOOR_PLAN", "HUMAN_HEIGHT_STATS", "STANDARD_OBJECT", "MODEL_ESTIMATE", "DATASET_GT", "MARKER",
        "MEASURED_OBJECT", "KNOWN_PERSON_HEIGHT"
      ],
      "description": "스케일 근거 (명세 4.3 우선순위: 실측 정물 > 키를 아는 사람 > 사람 키 통계 > 표준 사물 크기 > 모델 자체 추정). MEASURED_OBJECT = 치수를 미리 잰 정물(안전봉·라바콘 등), KNOWN_PERSON_HEIGHT = 키를 미리 잰 사람의 보정 걷기, HUMAN_HEIGHT_STATS = 지나간 여러 사람의 키 통계, STANDARD_OBJECT = 문·책상 같은 표준 사물 크기, MODEL_ESTIMATE = 모델(MapAnything 등) 메트릭 추정, MARKER = ChArUco 보드 등 치수를 아는 마커, DATASET_GT = 공개 데이터 정답. FLOOR_PLAN 은 수정 6 이후 쓰지 않는다(실측 평면도 제거). 이전 문서 호환을 위해 값만 남긴다"
    },
    "camera_calibration": {
      "type": "object",
      "required": ["camera_id", "image_size", "K", "distortion", "R", "t"],
      "properties": {
        "camera_id": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
        "image_size": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] 픽셀. 스트림 해상도가 바뀌면 이 보정은 DRIFTED"
        },
        "K": { "$ref": "../common/defs.schema.json#/$defs/mat3" },
        "distortion": {
          "type": "object",
          "required": ["model", "coeffs"],
          "properties": {
            "model": { "enum": ["OPENCV_PINHOLE", "OPENCV_FISHEYE", "NONE"] },
            "coeffs": {
              "type": "array",
              "items": { "type": "number" },
              "description": "OPENCV_PINHOLE: [k1, k2, p1, p2, k3, ...], OPENCV_FISHEYE: [k1, k2, k3, k4], NONE: []"
            }
          },
          "additionalProperties": false
        },
        "R": { "$ref": "../common/defs.schema.json#/$defs/mat3", "description": "World → 카메라 회전. 직교·det=+1은 계약 시험에서 검사" },
        "t": { "$ref": "../common/defs.schema.json#/$defs/vec3", "description": "World → 카메라 이동, 미터" },
        "camera_height_m": { "type": "number", "description": "바닥(Z=0)에서 카메라 중심까지 높이. 검산용" },
        "reprojection_error_px": {
          "type": "object",
          "properties": {
            "median": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
