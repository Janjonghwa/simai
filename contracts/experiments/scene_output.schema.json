{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.dev/contracts/experiments/scene_output.schema.json",
  "title": "정적 장면 결과 (EXP-01, static_reconstruct)",
  "description": "정적 3D 복원 결과 한 건 (명세 5.3, 20.2, 20.4). 보기용 Visual Geometry이며 안전 판단용 Operational Geometry(등록 작업면·정적 객체의 보수적 OBB, 명세 7.5)가 아니다. 2.3.0(-539, 마이너): method 에 WORLDMIRROR2_HYBRID·복원 경로 reconstruction_path·폴백 사유 fallback_reason·깊이 정합 기록 pose_depth_fit·맵 전용 카메라 자세 사본 map_cameras 및 후처리 MESH_CLEAN_V2·BACKING_PLANES·FURNITURE_PLANES·LAMA_INPAINT 추가, SURFACE_SOURCE_MAP 값 표·비율에 5 = SEE_THROUGH(개구부 비채움) 선택 키 추가. 2.2.0(-461, 마이너): quality 에 이전 모습으로 채운 비율 previous_fill_ratio·비운 비율 unrevealed_ratio 및 카메라별 비율 camera_background_quality 추가. 2.1.0(-317, 마이너): 자산 종류 SURFACE_SOURCE_MAP(배경 메시 텍셀 출처 지도)과 그 자산에만 쓰는 값 표 surface_values·표면적 비율 ratios(추정 평면 ESTIMATED_PLANE = 3, 생성 GENERATED = 4 예약), 후처리 CROSS_VIEW_ALIGNMENT·PLANE_CLEANUP(-314) 추가. 2.0.0 의미 변경(메이저): input_provenance.calibration.source(common/defs calibration_source)에서 v1.3 에서 쓰지 않는 마커 보정·평면도 대응점 출처 값을 뺐다.",
  "type": "object",
  "required": [
    "schema_version", "scene_version", "state", "geometry_role", "created_at",
    "calibration_version", "coordinate_frame", "input_provenance", "reproducibility",
    "method", "assets", "quality"
  ],
  "properties": {
    "schema_version": { "$ref": "../common/defs.schema.json#/$defs/semver" },
    "scene_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
    "state": { "$ref": "../common/defs.schema.json#/$defs/scene_state" },
    "geometry_role": { "const": "VISUAL", "description": "안전 판단에 쓰지 않는다" },
    "created_at": { "$ref": "../common/defs.schema.json#/$defs/timestamp_ms" },
    "experiment_id": { "type": "string", "description": "EXP-01 등. 제품 경로에서 만든 결과면 생략" },
    "calibration_version": { "$ref": "../common/defs.schema.json#/$defs/version_id" },
    "coordinate_frame": { "$ref": "../common/defs.schema.json#/$defs/coordinate_frame" },
    "input_provenance": { "$ref": "../common/defs.schema.json#/$defs/input_provenance" },
    "reproducibility": { "$ref": "../common/defs.schema.json#/$defs/reproducibility" },

    "method": {
      "type": "object",
      "required": ["reconstructor", "uses_known_pose"],
      "properties": {
        "reconstructor": { "enum": ["MAPANYTHING_NATIVE", "MAPANYTHING_EXTERNAL", "WORLDMIRROR2_HYBRID", "MOGE3", "VGGT", "FLOOR_PLAN_PRIMITIVES", "OTHER"] },
        "reconstructor_detail": { "type": "string" },
        "uses_known_pose": { "type": "boolean", "description": "보정 K·pose를 입력으로 썼는지 (명세 16: MapAnything Native 우선 이유)" },
        "reconstruction_path": {
          "enum": ["METHOD2_CALIB_WM2", "FALLBACK1_MA_ALIGNED_WM2", "FALLBACK1_MA_ALIGNED_NATIVE", "FALLBACK2_LEGACY_TEXRECON"],
          "description": "최종 맵 파이프라인(S15P31A101-539)에서 선택된 복원·굽기 경로"
        },
        "fallback_reason": {
          "type": ["string", "null"],
          "description": "새 경로(방식 2·폴백 1) 또는 텍스처 단계가 실패해 폴백 경로(폴백 2 등)로 전환된 사유 (S15P31A101-539)"
        },
        "pose_depth_fit": {
          "type": "object",
          "description": "방식 2(calibration.json 자세 고정 + 특징점·바닥 깊이 정합) 진단 및 게이트 통과 기록 (S15P31A101-539)",
          "required": ["passed", "model"],
          "properties": {
            "passed": { "type": "boolean" },
            "model": { "enum": ["M1_SCALE", "M2_SCALE_OFFSET", "M4_RAY_TILT", "NONE"] },
            "failure_reason": { "type": ["string", "null"] },
            "max_camera_abs_dz_median_m": { "type": ["number", "null"], "minimum": 0 },
            "max_camera_rel_dz_median": { "type": ["number", "null"], "minimum": 0 },
            "coobserved_surface_3d_median_m": { "type": ["number", "null"], "minimum": 0 },
            "floor_z_median_m": { "type": ["number", "null"] },
            "floor_tilt_deg": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "map_cameras": {
          "type": "object",
          "description": "이 맵의 기하·텍스처에 실제로 쓰인 단일 카메라 자세 집합 사본 (S15P31A101-539). Tier 0 calibration.json 정본을 덮어쓰지 않고 뷰어 VDT 가 참조한다",
          "propertyNames": { "$ref": "../common/defs.schema.json#/$defs/camera_id" },
          "additionalProperties": {
            "type": "object",
            "required": ["image_size", "K", "R", "t", "pose_source"],
            "properties": {
              "image_size": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 1 }
              },
              "K": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "type": "number" }
                }
              },
              "R": {
                "type": "array",
                "description": "3x3 회전 행렬 (World → OpenCV 카메라, p_cam_cv = R * p_world + t, OPENCV_WORLD_TO_CAMERA)",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": { "type": "number" }
                }
              },
              "t": {
                "type": "array",
                "description": "3x1 이동 벡터 (m, World → OpenCV 카메라, p_cam_cv = R * p_world + t, 광학 중심 C_world = -R^T * t)",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "number" }
              },
              "pose_source": { "enum": ["CALIBRATION", "MA_ALIGNED_SIM3", "MA_ALIGNED"] }
            },
            "additionalProperties": false
          }
        },
        "human_removal": { "enum": ["EMPTY_ROOM", "MASK_COMPOSITE", "NONE"], "description": "사람 제거 방식 (명세 5.3 촬영 조건)" },
        "postprocess": {
          "type": "array",
          "items": { "enum": ["DEPTH_ALIGNMENT", "CROSS_VIEW_ALIGNMENT", "OUTLIER_REMOVAL", "TSDF_FUSION", "PLANE_CLEANUP", "POISSON", "TEXTURE", "DECIMATION", "WORLD_ALIGNMENT", "MESH_CLEAN_V2", "BACKING_PLANES", "FURNITURE_PLANES", "LAMA_INPAINT"] },
          "description": "적용한 후처리 순서. CROSS_VIEW_ALIGNMENT 는 카메라 간 깊이 겹침으로 자세를 되맞춤, PLANE_CLEANUP 은 수평 평면 군집의 정점을 맞춘 평면에 올림(그 면은 출처 지도에서 ESTIMATED_PLANE, -314). MESH_CLEAN_V2·BACKING_PLANES·FURNITURE_PLANES·LAMA_INPAINT 는 최종 맵 파이프라인(-539)"
        }
      },
      "additionalProperties": false
    },

    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "uri", "sha256"],
        "properties": {
          "kind": {
            "enum": ["GLTF_VISUAL", "POINT_CLOUD", "DEPTH_MAPS", "MESH_RAW", "PREVIEW_IMAGE", "SURFACE_SOURCE_MAP"],
            "description": "SURFACE_SOURCE_MAP(2.1.0): GLTF_VISUAL 의 텍셀 출처 지도. 무손실 8비트 단일 채널 PNG, 알베도 아틀라스와 같은 UV·해상도, 최근접 표본으로 읽는다(밉맵·선형 보간 금지). 아틀라스(재질)마다 한 장이면 재질 순서대로 한 자산씩 싣는다(glb extras.simai.surface_source.maps 와 같은 순서). 겹친 텍셀은 신뢰가 낮은 값을 남긴다(미관측 < 생성 < 보간 < 추정 평면 < 관측, docs/design/exp01-textured-mesh.md '텍셀 출처 지도')"
          },
          "uri": { "$ref": "../common/defs.schema.json#/$defs/uri" },
          "sha256": { "$ref": "../common/defs.schema.json#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "axis_convention": {
            "enum": ["WORLD_Z_UP", "GLTF_Y_UP"],
            "description": "GLTF_VISUAL은 glTF 규약(+Y 상방, World (x,y,z) → (x, z, −y))으로 내보낸다. 변환은 내보내기 어댑터 한 곳에서만 한다"
          },
          "triangle_count": { "type": "integer", "minimum": 0 },
          "surface_values": {
            "type": "object",
            "description": "SURFACE_SOURCE_MAP 에만. 텍셀 값 → 출처 이름 표. 0·1·2 는 EXP-02 아바타 표면 출처 지도(avatar_asset surface_source.mask_uri)와 같은 값이고 배경에는 얼굴 비트(+128)가 없다. 3 = ESTIMATED_PLANE: 색은 그 카메라 관측 픽셀이나 정점을 맞춘 수평 평면에 올린 면(형상이 관측 그대로가 아니다, 원칙 8). 4 = GENERATED: 값 자리만 예약(관측 근거 없는 색은 만들지 않는다). 표에 없는 값과 이 표를 모르는 쪽(0·1·2 만 읽는 쪽)은 그 텍셀을 0(미관측)으로 읽는다(관측으로 승격 금지)",
            "required": ["0", "1", "2"],
            "properties": {
              "0": { "const": "UNOBSERVED" },
              "1": { "const": "INTERPOLATED" },
              "2": { "const": "OBSERVED" },
              "3": { "const": "ESTIMATED_PLANE" },
              "4": { "const": "GENERATED" },
              "5": { "const": "SEE_THROUGH" }
            },
            "additionalProperties": false
          },
          "ratios": {
            "type": "object",
            "description": "SURFACE_SOURCE_MAP 에만. 출처별 비율 0~1, 배경 메시 전체 표면적 기준(미관측 면은 아틀라스에 없어 텍셀 기준이 아니다). 지도가 여러 장이어도 같은 값이다. 잰 값만 싣는다(모르면 키를 뺀다)",
            "minProperties": 1,
            "properties": {
              "UNOBSERVED": { "type": "number", "minimum": 0, "maximum": 1 },
              "INTERPOLATED": { "type": "number", "minimum": 0, "maximum": 1 },
              "OBSERVED": { "type": "number", "minimum": 0, "maximum": 1 },
              "ESTIMATED_PLANE": { "type": "number", "minimum": 0, "maximum": 1 },
              "GENERATED": { "type": "number", "minimum": 0, "maximum": 1 },
              "SEE_THROUGH": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "if": { "properties": { "kind": { "const": "SURFACE_SOURCE_MAP" } }, "required": ["kind"] },
        "then": { "required": ["surface_values"] },
        "else": { "properties": { "surface_values": false, "ratios": false } }
      }
    },

    "quality": {
      "type": "object",
      "description": "G4 지표 (명세 15.1). 측정하지 못한 항목은 null로 두고 이유를 notes에 적는다",
      "required": ["wall_deviation_m", "observed_surface_ratio"],
      "properties": {
        "wall_deviation_m": {
          "oneOf": [
            {
              "type": "object",
              "required": ["median", "p95", "max"],
              "properties": {
                "median": { "type": "number", "minimum": 0 },
                "p95": { "type": "number", "minimum": 0 },
                "max": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ],
          "description": "평면도 벽 대비 차이. G4 목표 5cm 이하"
        },
        "desk_top_height_error_m": { "type": ["number", "null"] },
        "desk_position_error_m": { "type": ["number", "null"] },
        "coobserved_point_disagreement_median_m": { "type": ["number", "null"] },
        "scale_factor_vs_floor_plan": { "type": ["number", "null"], "description": "1.0이 정확. MoGe-3 PoC의 뷰별 0.94~1.23 같은 흔들림을 기록" },
        "observed_surface_ratio": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "관측된 표면 비율. 나머지는 추정·보간 (관측과 추정 구분, 원칙 8)"
        },
        "previous_fill_ratio": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "최근 창에서 가려져 이전 모습(배경/텍스처)으로 채운 비율 (S15P31A101-461)"
        },
        "unrevealed_ratio": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "최근 창과 이전 모습 모두에서 관측되지 않아 비운 비율 (S15P31A101-461)"
        },
        "camera_background_quality": {
          "type": "object",
          "additionalProperties": { "$ref": "../messages/scene_regenerate.schema.json#/$defs/camera_regenerate_quality" },
          "description": "카메라별 배경 합성 품질 비율 (S15P31A101-461)"
        },
        "failure_cases": { "type": "array", "items": { "type": "string" }, "description": "가림, 반사, 저텍스처 등" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "performance": {
      "type": "object",
      "properties": {
        "stage_latency_ms": {
          "type": "object",
          "additionalProperties": { "$ref": "../common/defs.schema.json#/$defs/percentiles_ms" },
          "description": "단계 이름 → p50/p95 (inference, io, postprocess, render 등)"
        },
        "vram_peak_mb": { "type": "number", "minimum": 0 },
        "gpu_model": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,

  "allOf": [
    {
      "description": "COMMITTED는 정답·시뮬레이션 입력이 아닌 결과만 가능 (명세 20.4 규칙 3·4)",
      "if": { "properties": { "state": { "const": "COMMITTED" } }, "required": ["state"] },
      "then": { "properties": { "input_provenance": { "properties": { "is_upper_bound": { "const": false } } } } }
    }
  ]
}
