# 현장 경보 단말은 저장소 루트 .env 를 읽는다(--env-file 로 바꿀 수 있음). 이 파일은 이름만 적은 예시다.
# 실제 값은 커밋하지 않는다.
SIMAI_LAPTOP_ID=laptop-01
# EC2 주소. Tier 0 주소·포트는 여기서 조회한다(GET /api/endpoints/tier0). Pod 가 바뀌어도 고치지 않는다
SIMAI_EC2_BASE_URL=
SIMAI_DEVICE_TOKEN=
# 미리 고정한 Tier 0 TLS 공개키 지문 sha256:<hex 64>. 키를 바꾸는 동안에는 쉼표로 옛 키·새 키를 함께 적는다
SIMAI_TIER0_PINNED_SPKI_SHA256=
# Tier 0 I0 제어 WebSocket 경로 (기본 /control)
# SIMAI_TIER0_CONTROL_PATH=/control
# 팀 사설 CA 를 쓰면
# SIMAI_TIER0_CA_FILE=
# 영상 중계(gateway/relay) 상태 보고를 받는 127.0.0.1 UDP 포트 (기본 47031, 중계 --status-port 와 같은 값)
# SIMAI_RELAY_STATUS_PORT=47031
# 녹화 재생 시험 알림 스위치(S15P31A101-736, 기본 false). true 면 녹화 파일 재생 중에도 경보 소리를 실제처럼 내고
# 「재생 시험 · 실제 알림 켜짐」 띠를 띄운다. 리허설·시험 때만 켜고 단말을 다시 띄운다. 본 시연(라이브) 전에 반드시 지우거나 false
# SIMAI_REPLAY_TEST_ALERTS=false
