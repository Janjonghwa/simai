# 저장소 루트 .env 의 키 이름 예시다. 이 파일을 .env 로 복사해 값을 채운다. 실제 값은 커밋하지 않는다(.gitignore).
# 녹화(gateway/recorder)·RTSP 측정(gateway/rtsp_probe)·현장 경보 단말(gateway/site_alert)·EXP-02 라이브 도구가 이 .env 를 읽는다.

# ── 카메라 RTSP (gateway/recorder, gateway/rtsp_probe) ──
# 카메라 주소(host)는 여기 쓰지 않는다. 녹화는 gateway/recorder/sessions/*.toml 의 [[cameras]], 측정은 --host 로 준다.
RTSP_PORT=554
RTSP_PATH=stream1
# 카메라마다 계정이 다르다: RTSP_USER_<camera_id 대문자, - 는 _> . 카메라별 값이 없으면 RTSP_USER / RTSP_PASS 를 쓴다.
RTSP_USER_CAM_A=
RTSP_PASS_CAM_A=
RTSP_USER_CAM_B=
RTSP_PASS_CAM_B=
RTSP_USER_CAM_C=
RTSP_PASS_CAM_C=
RTSP_USER_CAM_D=
RTSP_PASS_CAM_D=
# 4대가 같은 계정이면 위 대신
# RTSP_USER=
# RTSP_PASS=

# ── 현장 경보 단말 (gateway/site_alert) ── 자세한 설명은 gateway/site_alert/.env.example
# SIMAI_LAPTOP_ID=laptop-01
# SIMAI_EC2_BASE_URL=
# SIMAI_DEVICE_TOKEN=
# SIMAI_TIER0_PINNED_SPKI_SHA256=

# ── EC2 서버 (server) ── 서버는 .env 를 읽지 않는다. 아래 이름으로 환경 변수를 둔다. docs/design/server-auth.md
# 서버 포트. 비우면 8080
# SERVER_PORT=8080
# DB 접속. URL·사용자는 기본값(localhost:5432/simai, postgres)과 다를 때만 주석을 푼다. 빈 값으로 두면 기본값을 덮는다
# DB_URL=jdbc:postgresql://localhost:5432/simai
# DB_USERNAME=postgres
DB_PASSWORD=
# JWT 서명 키: Base64, 32바이트 이상. 예: openssl rand -base64 32
SIMAI_JWT_SECRET=
# 갱신 토큰 쿠키 Secure 속성. https 가 아닌 로컬 시험(Postman 등)에서만 false
# SIMAI_REFRESH_COOKIE_SECURE=true
# 관제 앱 개발 서버 출처(쉼표로 여러 개). 운영은 비움. 예: http://localhost:5173
SIMAI_CORS_ALLOWED_ORIGINS=

# ── EXP-02 라이브 데모 (ai/experiments/hmr/live_client.py) ── RunPod HTTPS 프록시 주소와 서버 토큰. 실행마다 새 토큰을 쓴다
LIVE_URL=
LIVE_TOKEN=

# ── HF 토큰 (GPU 이미지 simai-bootstrap 가중치 받기, S15P31A101-205) ── 값은 RunPod Secret·Vast 계정 env·엘리스 .simai-private/hf.env 에만 둔다
HF_TOKEN=

# ── RAG 조항 수집 (ai/src/simai_ai/rag/law.py) ── 국가법령정보 공동활용 Open API 인증값(OC). open.law.go.kr 에 등록한 서버 IP 에서만 응답한다
#   ai/ 에서 uv run --env-file ../.env python -m simai_ai.rag.seed fetch
SIMAI_LAW_API_OC=
