<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- 위험 알림의 등급별 진동 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- EC2 와의 I4 WebSocket 지속 연결(S15P31A101-337). 연결 유지는 포그라운드 서비스(connectedDevice 유형)로 한다.
         CHANGE_WIFI_STATE 는 connectedDevice 유형의 전제 권한이고, CHANGE_NETWORK_STATE 는 requestNetwork 로 망을 붙들 때 쓴다 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 알림을 받은 직후 진동·ACK 를 끝낼 때까지 잠들지 않게 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 연결 상태 알림(포그라운드 서비스)과 화면이 꺼진 채 위험 알림 화면을 띄우는 전체 화면 인텐트 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 워치가 다시 켜지면 연결을 다시 잇는다 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 손목을 내렸을 때 어둡게 켜져 있는 화면(앰비언트 모드)에 필요하다 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 기기 토큰이 백업으로 워치 밖에 나가지 않게 백업을 끈다 -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- 휴대폰 앱 없이 워치 혼자 동작한다(EC2 와 직접 연결, 부록 C.6) -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 위험 알림 화면. 알림 내용은 I4Service 가 들고 있고 이 화면은 보여 주고 확인을 받기만 한다. 잠금 화면 위에 띄우고 화면을 켠다.
             singleTop: 이미 떠 있으면 다시 만들지 않는다 -->
        <activity
            android:name=".AlertActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- adb 로 EC2 주소·기기 ID·기기 토큰을 넣는 입구(화면 없음). 사용법은 watch/README.md
             DUMP 는 adb shell 이 갖고 서드파티(비특권) 앱은 받을 수 없어, 워치의 다른 앱이 설정을 바꾸거나 지우지 못한다 -->
        <activity
            android:name=".ConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- EC2 와의 I4 연결을 화면이 꺼져도 유지하는 포그라운드 서비스. 알림 보관·진동·ACK 도 여기서 한다 -->
        <service
            android:name=".service.I4Service"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 부팅 뒤 설정이 있으면 연결을 다시 잇는다 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
