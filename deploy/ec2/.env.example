# EC2 운영 스택(deploy/ec2/compose.yaml)의 키 이름이다. 서버의 /opt/simai/.env 로 복사해 채우고 chmod 600 한다.
# 실제 값은 커밋하지 않는다. 비밀 값 만드는 법: openssl rand -base64 32

# 공개 도메인(DNS A 레코드가 EC2 를 가리켜야 한다). www.<도메인> 도 같은 인증서에 넣는다
SIMAI_DOMAIN=simai.live
# Let's Encrypt 만료 안내 메일
CERTBOT_EMAIL=
# 이미지 태그. docker buildx bake ec2 의 TAG 와 같게 둔다(예: 커밋 해시 12자)
SIMAI_TAG=dev
# Jenkins 이미지 태그(docker buildx bake jenkins 의 TAG). 앱 배포와 따로 올린다
SIMAI_JENKINS_TAG=dev
# 작업·세팅 진행 중 배포 보류의 안전장치(시간, 1 이상 정수). 없으면 12. deploy.sh 만 읽는다(S15P31A101-676)
# SIMAI_DEPLOY_HOLD_MAX_HOURS=12
# Tier 0 가 붙어 있다고 보는 시간(분, system_health 최근 수신). 없으면 3 (S15P31A101-682)
# SIMAI_DEPLOY_HOLD_TIER0_MINUTES=3
# 녹화 업로드 중으로 보는 시간(분, RECORDING_SEGMENT 업로드 주소 최근 발급). 없으면 10 (S15P31A101-682)
# SIMAI_DEPLOY_HOLD_UPLOAD_MINUTES=10

# DB 관리자 비밀번호. db 컨테이너를 처음 만들 때만 쓰인다(바꾸려면 DB 안에서 ALTER ROLE 도 해야 한다)
POSTGRES_PASSWORD=
# JWT 서명 키: Base64, 32바이트 이상
SIMAI_JWT_SECRET=
# Tier 0 토큰의 SHA-256(16진수). 원문은 Tier 0 의 SIMAI_TIER0_TOKEN 에만 둔다. 비우면 I1 연결을 모두 거부한다
# 만들기: TOKEN=$(openssl rand -base64 32) → Tier 0 에 TOKEN, 여기에 printf '%s' "$TOKEN" | sha256sum 의 앞부분
SIMAI_TIER0_TOKEN_SHA256=

# 화면 GPU 켜기·끄기·자동 정지(S15P31A101-702). RunPod 콘솔 Settings → API Keys. 비우면 켜기·재고 조회만 503 이고 서버는 뜬다
SIMAI_RUNPOD_API_KEY=
# GPU 가 등록에 쓰는 부팅 비밀값 ID(비밀 아님, `admin gpu-boot register --id` 와 같아야 한다)
SIMAI_GPU_BOOT_ID=gpu-boot-runpod

# AWS 서울 GPU(S15P31A101-703, docs/design/S15P31A101-703-aws-gpu-provider.md). 기본 꺼짐(false). 켜면 화면 「GPU 설정」에서 공급자 AWS 를 고를 수 있다
SIMAI_GPU_AWS_ENABLED=false
# GPU 켜기 전용 IAM 사용자 키(EC2 RunInstances·TerminateInstances·Describe*·iam:PassRole·pricing:GetProducts 만). 비우면 기본 자격 증명 체인
SIMAI_GPU_AWS_ACCESS_KEY_ID=
SIMAI_GPU_AWS_SECRET_ACCESS_KEY=
# 인스턴스가 띄울 GPU 이미지(ECR 서울 사본, 다이제스트 고정. 예: <계정>.dkr.ecr.ap-northeast-2.amazonaws.com/simai/tier0@sha256:...)
SIMAI_GPU_AWS_IMAGE=
# 인스턴스가 역할로 읽을 Secrets Manager 비밀 이름(비밀 아님). 값은 JSON {"SIMAI_GPU_BOOT_SECRET":…,"SIMAI_TIER0_TLS_PRIVATE_KEY":…,"HF_TOKEN":…}
SIMAI_GPU_AWS_SECRET_ID=simai/gpu-boot
# 노트북 고정 Tier 0 TLS 지문(공개). 있으면 AWS 인스턴스가 기동 전에 대조한다
SIMAI_TIER0_PINNED_SPKI_SHA256=

# 객체 저장소(S3, 비공개 버킷). 버킷을 비우면 업로드·조회 서명 주소만 503 이고 서버는 뜬다
SIMAI_STORAGE_BUCKET=
# 버킷이 있는 리전(예: ap-northeast-2 서울, ap-southeast-2 시드니)
SIMAI_STORAGE_REGION=ap-northeast-2
# IAM 사용자 액세스 키. 그 사용자에게는 이 버킷 객체의 s3:PutObject·s3:GetObject·s3:DeleteObject 만 준다
SIMAI_STORAGE_ACCESS_KEY=
SIMAI_STORAGE_SECRET_KEY=

# 시연용 기본 장면(배경 glTF·glb)의 위 버킷 객체 키(예: scenes/lobby/textured.glb). 비우면 배경만 안 뜬다
SIMAI_SCENE_DEFAULT_GLTF_KEY=

# TBM 보고서: 법령 그래프 읽기 전용 DB 연결과 외부 LLM 설정
SIMAI_RAG_PG_DSN=
SIMAI_LLM_BASE_URL=
SIMAI_LLM_MODEL=
SIMAI_LLM_API_KEY=
SIMAI_LLM_API_STYLE=
SIMAI_LLM_TIMEOUT_S=
SIMAI_LLM_TEMPERATURE=
SIMAI_LLM_MAX_OUTPUT_TOKENS=
