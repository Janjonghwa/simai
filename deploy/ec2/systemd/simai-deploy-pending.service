# 보류 배포 실행(S15P31A101-676). install-host.sh 가 /etc/systemd/system 에 넣고 User 를 배포 사용자로 바꾼다
[Unit]
Description=simai pending deploy (S15P31A101-676)
After=docker.service

[Service]
Type=oneshot
# Jenkins 배포 키가 deploy.sh 를 돌리는 사용자와 같아야 /opt/simai 의 잠금·보류 파일을 같이 쓴다
User=ubuntu
ExecStart=/opt/simai/bin/deploy-pending.sh
# 배포 도중에 끊으면 서비스가 반쯤 바뀐 채 남는다. 시간 제한은 deploy.sh 안의 단계별 제한(up 300초·curl)에 맡긴다
TimeoutStartSec=infinity
