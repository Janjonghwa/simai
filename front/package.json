{
  "name": "simai-front",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root check:generated",
    "lint:root": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && husky front/.husky"
  },
  "devDependencies": {
    "@simai/eslint-config": "workspace:*",
    "@simai/typescript-config": "workspace:*",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "apps/admin/**/*.{ts,tsx}": [
      "pnpm --filter admin exec eslint --fix",
      "prettier --write"
    ],
    "packages/ui/**/*.{ts,tsx}": [
      "pnpm --filter @simai/ui exec eslint --fix",
      "prettier --write"
    ],
    "packages/contracts/**/*.ts": [
      "pnpm --filter @simai/contracts exec eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^24.19.0"
  },
  "packageManager": "pnpm@11.24.0"
}
